# Mask pipewire/wireplumber per-user units system-wide (all users).
# Why: wireplumber competes with zita-j2a for hw:HID (USB audio), causing
# jack-alsa-bridges boot retries and ALSA glitches that trip
# JackAudioDriver::ProcessGraphAsyncMaster errors. /etc/systemd/user/
# overrides /usr/lib/systemd/user/ for every user's systemd --user instance.
# Symlinks target /dev/null — the standard systemd mask convention.
etc/systemd/user/pipewire.service etc/systemd/user/
etc/systemd/user/pipewire.socket etc/systemd/user/
etc/systemd/user/pipewire-pulse.service etc/systemd/user/
etc/systemd/user/pipewire-pulse.socket etc/systemd/user/
etc/systemd/user/wireplumber.service etc/systemd/user/

# GRUB recovery boot entry generator. On a CUEMS video host the compositor
# owns DRM master over every output, so there is no usable text console
# exactly when one is needed; this emits menu entries that boot with
# cuems-videocomposer masked via systemd.mask= on the kernel command line.
# Executable (dh_install preserves the source mode; debian/rules re-chmods as
# belt-and-braces) — grub-mkconfig silently skips a non-executable /etc/grub.d
# file. Installed under /etc/, so dpkg tracks it as a conffile: see the
# matching update-grub in debian/postinst and debian/postrm.
etc/grub.d/11_cuems_recovery etc/grub.d/

# Shell aliases
etc/profile.d/cuems.sh etc/profile.d/

# Configuration files
# avahi-daemon.conf and dhcpd.conf are NOT shipped as conffiles — they have no
# drop-in mechanism and must override another package's single file, so they
# ship as usr/share/cuems/ templates (via the glob below) that postinst installs
# through a dpkg-divert. See debian/postinst.
# NOTE: /etc/network/interfaces is intentionally NOT shipped — it is host- and
# role-specific. Operators deploy from the role templates under usr/share/cuems/
# (interfaces.master / interfaces.node; a future cuems-write-network-interfaces
# helper will pick the right one per role). Shipping a single live conffile here
# pushed the *master* variant onto nodes and risked clobbering host networking
# on every upgrade.
etc/rsyncd.conf etc/
etc/rsyncd.secrets etc/
# hostapd.conf is NOT shipped: cuems drives hostapd from /run/cuems/hostapd.conf
# (generated from usr/share/cuems/hostapd/hostapd.conf.template at ExecStartPre),
# so the /etc/hostapd/hostapd.conf conffile was unused.
# journald + rsyslog CUEMS policy ship as drop-ins (so we never divert
# systemd's or rsyslog's own conffile): the stock files keep ownership and
# these are pulled in via journald.conf.d/ and rsyslog.d/*.conf includes.
etc/systemd/journald.conf.d/cuems.conf etc/systemd/journald.conf.d/
# Same drop-in rationale for logind: pins HandlePowerKey=poweroff, the behaviour
# cuems-cluster-poweroff.service's ExecStop hook depends on. Matches systemd's
# compiled-in default, so it changes nothing — it states the contract.
etc/systemd/logind.conf.d/10-cuems-power-button.conf etc/systemd/logind.conf.d/
etc/rsyslog.d/cuems.conf etc/rsyslog.d/
etc/sudoers.d/99-cuems etc/sudoers.d/
etc/sudoers.d/50-cuems-admin etc/sudoers.d/

# SSH server hardening (drop-in; main /etc/ssh/sshd_config left untouched
# so upstream conffile-prompt machinery handles any operator edits there)
etc/ssh/sshd_config.d/50-cuems.conf etc/ssh/sshd_config.d/

# Organization SSH public key — planted in cuems-admin's authorized_keys
# on first install (see debian/postinst). Private half is held by Stagelab.
etc/cuems/ssh/cuems-org.pub etc/cuems/ssh/
etc/sudoers.d/99-cuems-poweroff etc/sudoers.d/
etc/sudoers.d/99-cuems-admin-poweroff etc/sudoers.d/
etc/sysctl.d/99-cuems-performance.conf etc/sysctl.d/
etc/modules-load.d/cuems-midi.conf etc/modules-load.d/

# systemd-udev .link files — rename Intel/Realtek NICs to stable
# ethernet0 / ethernet1 / wifi0 (Path= matches the PCI slot, so
# names survive USB MAC churn). Also enable WakeOnLan=magic on the
# ethernet NICs so remote-wake survives clean reboots without depending
# on NIC NVRAM persistence (which was the historical bug: an earlier
# cuems-common upgrade overwrote these files without the directive and
# WoL silently stopped persisting at OS level). udev's net_setup_link
# builtin applies these on every interface bring-up regardless of
# whether systemd-networkd itself is enabled.
etc/systemd/network/10-ethernet0.link etc/systemd/network/
etc/systemd/network/10-ethernet1.link etc/systemd/network/
etc/systemd/network/10-wifi0.link etc/systemd/network/

# Hardware-mismatch recovery guide for the .link files above. Operators
# whose NICs sit at different PCI paths than the N97 defaults MUST edit
# /etc/systemd/network/10-*.link to match — and pick "keep my version"
# on dpkg conffile prompts during upgrades.
usr/share/doc/cuems-common/link-files.README usr/share/doc/cuems-common/
etc/tmpfiles.d/jack-cuems.conf etc/tmpfiles.d/
etc/tmpfiles.d/cuems-journal-remote.conf etc/tmpfiles.d/
etc/logrotate.d/cuems etc/logrotate.d/
etc/cuems/network_map.xml etc/cuems/
etc/cuems/network_map.xsd etc/cuems/
# AP-network constants — single source of truth, sourced by check-ip.sh.
# /etc/dhcp/dhcpd.conf cross-references it via header comment.
etc/cuems/ap.conf etc/cuems/
etc/cuems/videocomposer-flags.env.example etc/cuems/
etc/cuems/gradient-motiond.env.example etc/cuems/
# Orderly power-off / boot display confirmation. Shell syntax (both readers are
# shell scripts); ships enabled=false so a fleet-wide upgrade changes no site.
etc/cuems/cluster-poweroff.conf etc/cuems/

# GPU clock pin. Shell syntax (the reader is a shell script); ships
# enabled=false so a fleet-wide upgrade never starts pinning clocks - and +8 C -
# on an AMD box nobody has thermally soaked.
etc/cuems/gpu-pin.conf etc/cuems/

# Multi-cluster identity example (not installed to /etc/cuems/ by default;
# operator copies it manually when multi-cluster deployment is needed).
etc/cuems/cluster.conf.example usr/share/doc/cuems-common/

# Shared data files
usr/share/cuems/* usr/share/cuems/

# Apache configuration
# Note: Module files come from their respective Debian packages (libapache2-mod-*)
