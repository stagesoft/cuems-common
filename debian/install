# /run/cuems/hostapd.conf redirect via drop-ins under hostapd.service.d/
# only — never overriding the unit file (was a dpkg file-conflict footgun).
etc/systemd/system/jack-alsa-bridges.service lib/systemd/system/
etc/systemd/system/jackd-cuems.service lib/systemd/system/
# Topology-independent WoL arm-er (alternative to per-host .link files which
# pin Match=Path= to a specific PCI topology; ours don't match across the N97
# cluster). Walks /sys/class/net and runs ethtool -s wol g on every physical
# ethernet NIC that hardware-supports magic-packet wake.
etc/systemd/system/cuems-arm-wol.service lib/systemd/system/
etc/systemd/system/olad.service lib/systemd/system/
# Retention for the journals uploaded by the nodes. systemd-journal-remote
# has no MaxUse=/MaxFiles= of its own on systemd 252, so a timer is the only
# bound — see the comment in systemd-journal-remote.service.d/.
etc/systemd/system/cuems-journal-vacuum.service lib/systemd/system/
etc/systemd/system/*.path lib/systemd/system/
etc/systemd/system/*.timer lib/systemd/system/
