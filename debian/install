etc/apache2/sites-available/cuems-ui.conf etc/apache2/sites-available/
etc/apache2/sites-available/cuems-ui-ssl.conf etc/apache2/sites-available/

# ACPI scripts: RETIRED in 1.3.0-16, removed via debian/cuems-common.maintscript.
# They never ran — acpid is not installed on any CUEMS host (verified on isil,
# test2 and both Medina controllers), so the physical power button has always been
# handled by systemd-logind's HandlePowerKey. The handler's first action was
# /usr/bin/cuems-stop, hardcoded to another site's relay and SSH targets, so
# leaving the files in place was a booby trap: installing acpid for any reason
# would have resurrected it. Replaced by cuems-cluster-poweroff.service, which
# hooks the poweroff transition instead and therefore also covers
# `systemctl poweroff`.

