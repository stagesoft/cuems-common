# Debian packaging rules for CUEMS Common

%:
	dh $@

# The repo root ships a multi-package orchestration Makefile used for release
# builds of the whole workspace. debhelper would take it for this package's own
# build system and run its targets: `build` would rebuild every CUEMS package,
# and `clean`, which a plain dpkg-buildpackage runs first, REMOVES GIT
# WORKTREES of other repositories. Every dh_auto_* step is therefore empty.
# This package has nothing to configure, build, test or clean; what it installs
# is listed in debian/install. (tests/test_packaging.py keeps it so.)
override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:

override_dh_auto_clean:

override_dh_fixperms:
	# Ensure all scripts in /usr/lib/cuems/bin/ are executable
	dh_fixperms
	chmod +x debian/cuems-common/usr/lib/cuems/bin/*.sh 2>/dev/null || true
	chmod +x debian/cuems-common/usr/lib/cuems/bin/*.py 2>/dev/null || true

override_dh_install:
	dh_install
	# Ensure scripts are executable after installation
	find debian/cuems-common/usr/lib/cuems/bin/ -type f -name "*.sh" -exec chmod +x {} \;
	find debian/cuems-common/usr/lib/cuems/bin/ -type f -name "*.py" -exec chmod +x {} \;
	# grub-mkconfig silently SKIPS a non-executable /etc/grub.d file, so a
	# lost mode bit would drop the recovery entry with no error anywhere.
	chmod 0755 debian/cuems-common/etc/grub.d/11_cuems_recovery 2>/dev/null || true
	# systemd silently ignores a generator that is not executable.
	chmod 0755 debian/cuems-common/lib/systemd/system-generators/cuems-firstboot-generator

override_dh_installdeb:
	dh_installdeb
	# Remove xinitrc.cuems from conffiles - we want to always overwrite it
	@if [ -f debian/cuems-common/DEBIAN/conffiles ]; then \
		sed -i '/\/etc\/X11\/xinit\/xinitrc\.cuems/d' debian/cuems-common/DEBIAN/conffiles; \
	fi

