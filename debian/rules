#!/usr/bin/make -f
# Debian packaging rules for CUEMS Common

%:
	dh $@

# The repo root ships a multi-package orchestration Makefile used for
# release builds. dh_auto_build would pick it up as this package's own
# build step and try to rebuild every CUEMS package — suppress that.
# (Mirrors the same fix already present on the debian/bookworm branch.)
override_dh_auto_build:

override_dh_fixperms:
	# Ensure all scripts in /usr/lib/cuems/bin/ are executable
	dh_fixperms
	chmod +x debian/cuems-common/usr/lib/cuems/bin/*.sh 2>/dev/null || true
	chmod +x debian/cuems-common/usr/lib/cuems/bin/*.py 2>/dev/null || true

override_dh_install:
	dh_install
	# Ensure scripts are executable after installation
	find debian/cuems-common/usr/lib/cuems/bin/ -type f -name "*.sh" -exec chmod +x {} \;
	find debian/cuems-common/usr/lib/cuems/bin/ -type f -name "*.py" -exec chmod +x {} \;

