# rtpmidid config for node hosts.
# Generated by cuems-write-rtpmidid-config (ExecStartPre of rtpmidid.service).
# DO NOT EDIT — changes are overwritten at every rtpmidid (re)start.
# Source templates live in /usr/share/cuems/rtpmidid/.
#
# IMPORTANT: `hostname=controller.local` relies on avahi resolving the
# controller correctly. Cloned hosts often share the same avahi host-name
# (see CLAUDE.md "Avahi-hostname-collision gotcha"). Ensure each host
# advertises a unique name in /etc/avahi/avahi-daemon.conf and that
# the controller advertises itself as `controller`.

[general]
alsa_name=rtpmidid
control=/var/run/rtpmidid/control.sock

[rtpmidi_announce]
name={{hostname}}
port=5004

[rtpmidi_discover]
enabled=true
name_negative_regex=^$
name_positive_regex=.*

[alsa_announce]
name=Network Export

# Explicit peer connection to the controller. The ALSA seq port created
# locally for this peer is named `controller` (matches `name=` below).
# cuems-midi-connector wires every non-infra rtpmidid port into
# Midi Through Port-0, so this port becomes the MTC ingress.
[connect_to]
hostname=controller.local
name=controller
