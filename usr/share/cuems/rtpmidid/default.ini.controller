# rtpmidid config for controller hosts.
# Generated by cuems-write-rtpmidid-config (ExecStartPre of rtpmidid.service).
# DO NOT EDIT — changes are overwritten at every rtpmidid (re)start.
# Source templates live in /usr/share/cuems/rtpmidid/.

[general]
alsa_name=rtpmidid
control=/var/run/rtpmidid/control.sock

[rtpmidi_announce]
name={{hostname}}
port=5004

[rtpmidi_discover]
enabled=true
name_negative_regex=^$
name_positive_regex=.*

[alsa_announce]
name=Network Export

# Controllers do not declare [connect_to]: nodes initiate the connection
# inbound. The peer port names exposed by rtpmidid on a controller therefore
# come from each node's [rtpmidi_announce].
