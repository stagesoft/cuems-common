"""Render /run/cuems/hostapd.conf from template + cluster.conf.

Invoked from hostapd.service ExecStartPre on every (re)start. The SSID is
public, so it carries the commercial name Formitgo, never the internal
"cuems". From /etc/cuems/cluster.conf: ssid=<free text> wins (spaces
allowed, 1-32 bytes); else cluster_name=<x> -> "Formitgo_<x>"; absent or
"default" -> bare "Formitgo". The WPA passphrase comes from
the DEFAULT_WIFI_PASSPHRASE env var (set by the systemd drop-in) or
falls back to the published default literal below — see
docs/default-credentials.md for the operator-facing disclosure.

Literal str.replace is injection-safe regardless of passphrase content,
so operators can rotate to passphrases containing pipes / backslashes /
ampersands without breaking the renderer.
"""
import os
import re
import sys
import tempfile
import shutil
from pathlib import Path

TEMPLATE = Path("/usr/share/cuems/hostapd/hostapd.conf.template")
CLUSTER_CONF = Path("/etc/cuems/cluster.conf")
OUT = Path("/run/cuems/hostapd.conf")

DEFAULT_PASSPHRASE = "cuems-wifi-default"


BRAND = "Formitgo"


def valid_ssid(ssid: str) -> bool:
    return 1 <= len(ssid.encode()) <= 32 and ssid.isprintable()


def derive_ssid() -> str:
    explicit = derived = None
    if CLUSTER_CONF.is_file():
        for line in CLUSTER_CONF.read_text().splitlines():
            m = re.match(r"\s*ssid\s*=\s*(.*?)\s*$", line)
            if m and explicit is None:
                explicit = m.group(1)
            m = re.match(r"\s*cluster_name\s*=\s*(\S+)", line)
            if m and derived is None and m.group(1) != "default":
                derived = f"{BRAND}_{m.group(1)}"
    if explicit is not None:
        if valid_ssid(explicit):
            return explicit
        print(
            f"cuems-write-hostapd-config: ignoring invalid ssid={explicit!r} "
            "(needs 1-32 bytes, printable)",
            file=sys.stderr,
        )
    if derived and valid_ssid(derived):
        return derived
    return BRAND


def main() -> int:
    if not TEMPLATE.is_file():
        print(
            f"cuems-write-hostapd-config: missing template {TEMPLATE}",
            file=sys.stderr,
        )
        return 1

    ssid = derive_ssid()
    passphrase = os.environ.get("DEFAULT_WIFI_PASSPHRASE", DEFAULT_PASSPHRASE)

    body = TEMPLATE.read_text()
    body = body.replace("@@SSID@@", ssid)
    body = body.replace("@@WPA_PASSPHRASE@@", passphrase)

    OUT.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=OUT.parent, delete=False
    ) as tf:
        tf.write(body)
        tmp = Path(tf.name)
    os.chmod(tmp, 0o600)
    shutil.move(str(tmp), str(OUT))

    print(f"cuems-write-hostapd-config: wrote {OUT} (ssid={ssid})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
