"""Read video output mappings from default_mappings.xml and generate
a display.conf that the videocomposer can load at startup.

The XML file is the single source of truth for connector->region mappings.
The generated config is written to /run/cuems/display.conf (tmpfs, ephemeral).

Filters by the local node's UUID (read from /etc/cuems/settings.xml).
Without the filter, every host would emit every other peer's outputs into
its own display.conf, producing duplicate or phantom [output:...] sections
and (on the controller) stuck render threads waiting on connectors that do
not exist locally.
"""

import os
import sys
import xml.etree.ElementTree as ET

SETTINGS_XML = '/etc/cuems/settings.xml'
MAPPINGS_XML = '/etc/cuems/default_mappings.xml'
OUTPUT_DIR = '/run/cuems'
OUTPUT_FILE = os.path.join(OUTPUT_DIR, 'display.conf')


def read_local_uuid(path):
    if not os.path.isfile(path):
        return None
    try:
        tree = ET.parse(path)
    except ET.ParseError as e:
        print('settings.xml parse error: {}'.format(e), file=sys.stderr)
        return None
    uuid_el = tree.find('.//Settings/node/uuid')
    if uuid_el is None or uuid_el.text is None:
        return None
    return uuid_el.text.strip()


def parse_video_outputs(xml_path, local_uuid):
    tree = ET.parse(xml_path)
    root = tree.getroot()

    if local_uuid:
        target_node = None
        for node_el in root.findall('.//nodes/node'):
            uuid_el = node_el.find('uuid')
            if uuid_el is not None and uuid_el.text and uuid_el.text.strip() == local_uuid:
                target_node = node_el
                break
        if target_node is None:
            print('Local UUID {} not found in {}; falling back to all outputs'.format(
                local_uuid, xml_path), file=sys.stderr)
            search_root = root
        else:
            search_root = target_node
    else:
        print('No local UUID available; falling back to all outputs', file=sys.stderr)
        search_root = root

    explicit = []
    auto = []
    for output_el in search_root.findall('.//video/outputs/output'):
        mapped_el = output_el.find('mappings/mapped_to')
        if mapped_el is None or mapped_el.text is None:
            continue
        connector = mapped_el.text.strip()
        id_el = output_el.find('id')
        try:
            output_id = int(id_el.text) if id_el is not None and id_el.text else 0
        except ValueError:
            output_id = 0
        region_el = output_el.find('canvas_region')
        if region_el is not None:
            x = int(region_el.findtext('x', '0'))
            y = int(region_el.findtext('y', '0'))
            w = int(region_el.findtext('width', '1920'))
            h = int(region_el.findtext('height', '1080'))
            explicit.append((output_id, connector, x, y, w, h))
        else:
            auto.append((output_id, connector))

    # Outputs without <canvas_region> get auto-laid out side-by-side, sorted by
    # <id>. Placement starts to the right of any explicit regions so an XML
    # mixing both styles doesn't overlap.
    auto.sort(key=lambda t: t[0])
    explicit_right = max((x + w for _id, _c, x, _y, w, _h in explicit), default=0)
    for index, (output_id, connector) in enumerate(auto):
        x = explicit_right + index * 1920
        explicit.append((output_id, connector, x, 0, 1920, 1080))

    # Preserve XML document order for the file output (callers care about the
    # connector→region mapping, not the order; ordering by id is stable.)
    explicit.sort(key=lambda t: t[0])
    return [(c, x, y, w, h) for _id, c, x, y, w, h in explicit]


def write_display_conf(outputs, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write('# Auto-generated from {}\n'.format(MAPPINGS_XML))
        f.write('canvas_layout=custom\n\n')
        for connector, x, y, w, h in outputs:
            f.write('[output:{}]\n'.format(connector))
            f.write('canvas_region={},{},{},{}\n'.format(x, y, w, h))
            f.write('\n')


def main():
    if not os.path.isfile(MAPPINGS_XML):
        print('No mappings file at {}, skipping'.format(MAPPINGS_XML), file=sys.stderr)
        return 0
    local_uuid = read_local_uuid(SETTINGS_XML)
    try:
        outputs = parse_video_outputs(MAPPINGS_XML, local_uuid)
    except ET.ParseError as e:
        print('XML parse error: {}'.format(e), file=sys.stderr)
        return 1
    if not outputs:
        print('No video outputs found in {} for uuid={}'.format(MAPPINGS_XML, local_uuid),
              file=sys.stderr)
        return 0
    write_display_conf(outputs, OUTPUT_FILE)
    print('Generated {} with {} output(s) for uuid={}'.format(
        OUTPUT_FILE, len(outputs), local_uuid))
    return 0


if __name__ == '__main__':
    sys.exit(main())
