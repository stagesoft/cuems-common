"""Interactive operator tool to author /etc/cuems/display.conf.

Probes connected DRM outputs, walks the operator through resolution +
layout choices, and writes /etc/cuems/display.conf. cuems-generate-
display-conf (videocomposer's ExecStartPre) copies the operator override
verbatim to /run/cuems/display.conf on every VC start, so the file is the
persistent authority.

On a re-run the tool rewrites only the keys it owns -- `canvas_region=` and
`resolution=` per output, `canvas_layout=` and `canvas_size=` globally,
recognised by the STRIPPED key -- and carries every other line (refresh=,
blend=, enabled=, color_*, unknown keys, comments) over as the raw line,
verbatim, in place. A section whose connector is not detected now is kept
unless the operator answers `drop`.

Run as root:  sudo cuems-display-setup
Inspect:      sudo cuems-display-setup --probe
"""

import argparse
import datetime
import glob
import os
import re
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET


DISPLAY_CONF = '/etc/cuems/display.conf'
DEFAULT_MAPPINGS_XML = '/etc/cuems/default_mappings.xml'
SETTINGS_XML = '/etc/cuems/settings.xml'
# The venv copy is the authoritative schema: cuemsutils builds its schemas
# dir from the package directory, so every CUEMS component validates against
# it. /etc/cuems/project_mappings.xsd is vestigial and lacks the mandatory
# <id> this tool inserts -- validating against it is a confident false FAIL.
PROJECT_MAPPINGS_XSD = ('/usr/lib/cuems/lib/python3.11/site-packages/'
                        'cuemsutils/xml/schemas/project_mappings.xsd')
PROJECT_MAPPINGS_XSD_GLOB = ('/usr/lib/cuems/lib/python3*/site-packages/'
                             'cuemsutils/xml/schemas/project_mappings.xsd')
MASTER_IP_SENTINEL = '/etc/cuems/master.ip'
SHOW_LOCK_PATH = '/tmp/cuems.show.lock'
CMS_NAMESPACE = 'https://stagelab.coop/cuems/'

# Keys this tool owns. A line is classed as owned by its STRIPPED key, so
# `canvas_region = ...`, `  canvas_region=...` and `canvas_region=...` are
# the same owned key: every variant is dropped and exactly one canonical
# column-0 line is written. Carrying a spaced copy would split the readers:
# the engine (configparser) strips keys and honours it, the VC does not strip
# keys and ignores it, and the two then compute different canvases.
OWNED_OUTPUT_KEYS = ('canvas_region', 'resolution')
OWNED_GLOBAL_KEYS = ('canvas_layout', 'canvas_size')
# Carried keys a geometry change makes questionable: asked about, one by one.
GEOMETRY_BOUND_KEYS = ('refresh', 'blend')
# Carried keys kept without a question: a device calibration, not geometry.
COLOR_KEY_PREFIX = 'color_'
AUTHORED_HEADER_PREFIX = '# Authored by cuems-display-setup'
# Raw lines round-trip byte for byte: no newline translation (newline='') and
# undecodable bytes carried through (surrogateescape).
CONF_ENCODING = 'utf-8'
CONF_ERRORS = 'surrogateescape'

# ---------------------------------------------------------------------------
# Hardware probe
# ---------------------------------------------------------------------------


def probe_connected_outputs():
    """Return list of dicts: {'card', 'connector', 'modes', 'edid_name'}.

    Walks /sys/class/drm/cardN-CONNECTOR/, picks the connected ones, reads
    the supported mode list (deduplicated by WxH preserving first
    occurrence), and asks edid-decode for a human-readable monitor label.
    """
    results = []
    seen_connectors = {}  # connector_name -> card_dir, for multi-GPU guard
    for status_path in sorted(glob.glob('/sys/class/drm/card*-*/status')):
        with open(status_path) as f:
            status = f.read().strip()
        if status != 'connected':
            continue
        card_dir = os.path.dirname(status_path)
        card_dir_name = os.path.basename(card_dir)  # e.g. card0-HDMI-A-1
        m = re.match(r'^(card\d+)-(.+)$', card_dir_name)
        if not m:
            continue
        card, connector = m.group(1), m.group(2)

        if connector in seen_connectors:
            sys.exit(
                f'ERROR: connector {connector!r} appears on both '
                f'{seen_connectors[connector]} and {card_dir}. '
                'display.conf cannot disambiguate same-named connectors '
                'across multiple GPUs. Aborting.'
            )
        seen_connectors[connector] = card_dir

        modes = _read_modes(os.path.join(card_dir, 'modes'))
        edid_name = _read_edid_name(os.path.join(card_dir, 'edid'))
        results.append({
            'card': card,
            'connector': connector,
            'modes': modes,
            'edid_name': edid_name,
        })
    return results


def _read_modes(modes_path):
    """Return deduplicated WxH list, preserving first-occurrence order.

    /sys/class/drm/.../modes lists `WIDTHxHEIGHT` one per line and may
    repeat the same WxH for different refresh rates. We dedup because the
    operator menu just needs distinct resolutions.
    """
    if not os.path.isfile(modes_path):
        return []
    out = []
    seen = set()
    with open(modes_path) as f:
        for line in f:
            mode = line.strip()
            if not mode or mode in seen:
                continue
            if not re.match(r'^\d+x\d+$', mode):
                continue
            seen.add(mode)
            out.append(mode)
    return out


def _read_edid_name(edid_path):
    """Best-effort monitor name via edid-decode. Returns None if absent.

    Note: /sys/class/drm/.../edid is a synthesized sysfs file — stat
    reports size 0 even when the read returns valid EDID bytes. We can't
    short-circuit on size; read the bytes and decide based on content.
    """
    if not os.path.isfile(edid_path):
        return None
    try:
        with open(edid_path, 'rb') as f:
            edid_bytes = f.read()
    except OSError:
        return None
    if not edid_bytes:
        return None
    try:
        result = subprocess.run(
            ['edid-decode'],
            input=edid_bytes,
            capture_output=True,
            timeout=5,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    stdout = result.stdout.decode('utf-8', errors='replace')
    mfr = None
    model = None
    for line in stdout.splitlines():
        line = line.strip()
        if line.startswith('Manufacturer:'):
            mfr = line.split(':', 1)[1].strip()
        elif line.startswith('Display Product Name:'):
            model = line.split(':', 1)[1].strip().strip("'\"")
    if mfr and model:
        return f'{mfr} {model}'
    return model or mfr


# ---------------------------------------------------------------------------
# Existing display.conf: raw model (preserve what we do not own)
# ---------------------------------------------------------------------------


class ConfSection:
    """One `[...]` section of display.conf, kept as raw lines.

    header     the raw header line, verbatim (with its own line ending)
    connector  the connector of an `[output:<connector>]` header, else None
    lines      the raw body lines, verbatim (with their own line endings)
    dropped    indices into `lines` the operator chose not to keep
    drop       True when the operator answered `drop` for the whole section
    """

    def __init__(self, header, connector):
        self.header = header
        self.connector = connector
        self.lines = []
        self.dropped = set()
        self.drop = False


class RawDisplayConf:
    """display.conf as raw lines: the global preamble, then the sections."""

    def __init__(self):
        self.preamble = []
        self.sections = []


def read_display_conf_raw(path=None):
    """Return the file's text with its line endings untouched, or None."""
    path = path or DISPLAY_CONF
    if not os.path.isfile(path):
        return None
    with open(path, encoding=CONF_ENCODING, errors=CONF_ERRORS,
              newline='') as f:
        return f.read()


def _printable(text):
    """Text safe to print: bytes carried through surrogateescape (not valid
    UTF-8) are shown as U+FFFD; the file itself keeps them."""
    return text.encode(CONF_ENCODING, CONF_ERRORS).decode(CONF_ENCODING,
                                                          'replace')


def split_raw_lines(text):
    """Split on '\\n', each line keeping its own terminator ('\\n' or
    '\\r\\n'); a last line without a terminator is kept without one."""
    parts = text.split('\n')
    lines = [p + '\n' for p in parts[:-1]]
    if parts[-1]:
        lines.append(parts[-1])
    return lines


def line_key(raw):
    """Return the STRIPPED key of a `key=value` line; None for a blank line,
    a comment or a line without '='."""
    s = raw.strip()
    if not s or s.startswith('#') or '=' not in s:
        return None
    return s.split('=', 1)[0].strip()


def _is_section_header(raw):
    # Like the VC: '[' opens a header and anything after its ']' is ignored.
    s = raw.strip()
    return s.startswith('[') and ']' in s


def _section_connector(raw):
    m = re.match(r'^\[output:([^\]]+)\]', raw.strip())
    return m.group(1) if m else None


def parse_display_conf_raw(text):
    """Return a RawDisplayConf holding every line of `text` verbatim."""
    conf = RawDisplayConf()
    current = None
    for raw in split_raw_lines(text):
        if _is_section_header(raw):
            current = ConfSection(raw, _section_connector(raw))
            conf.sections.append(current)
        elif current is None:
            conf.preamble.append(raw)
        else:
            current.lines.append(raw)
    return conf


def owned_values(section):
    """Return {owned key: stripped value} of a section (last line wins)."""
    vals = {}
    for raw in section.lines:
        key = line_key(raw)
        if key in OWNED_OUTPUT_KEYS:
            vals[key] = raw.split('=', 1)[1].strip()
    return vals


def owned_lines_are_canonical(section):
    """True when every owned line of the section starts at column 0 with
    its exact key and no owned key is repeated."""
    seen = set()
    for raw in section.lines:
        key = line_key(raw)
        if key not in OWNED_OUTPUT_KEYS:
            continue
        if key in seen or not raw.startswith(key + '='):
            return False
        seen.add(key)
    return True


def canonical_carried_lines(section):
    """Lines of a section this run has no new values for (its connector is
    not detected now). Verbatim when its owned lines are already canonical;
    otherwise each owned key becomes ONE canonical line, carrying the value
    of its last line (the engine's reading: configparser strips keys and the
    last duplicate wins), at the place of the first owned line."""
    if owned_lines_are_canonical(section):
        return list(section.lines)
    values = owned_values(section)
    out = []
    anchor = None
    for raw in section.lines:
        if line_key(raw) in OWNED_OUTPUT_KEYS:
            if anchor is None:
                anchor = len(out)
            continue
        out.append(raw)
    canonical = [f'{k}={values[k]}\n' for k in OWNED_OUTPUT_KEYS if k in values]
    out[anchor or 0:anchor or 0] = canonical
    return out


def _parse_region(value):
    """'x,y,w,h' -> (x, y, w, h); None when absent or malformed."""
    if value is None:
        return None
    parts = value.split(',')
    if len(parts) != 4:
        return None
    try:
        return tuple(int(p.strip()) for p in parts)
    except ValueError:
        return None


def load_existing_display_conf(path=None):
    """Return {connector: {x, y, width, height, resolution?, refresh?}} from
    /etc/cuems/display.conf so re-runs can pre-fill defaults. Empty dict
    if file missing. Keys are read stripped, the last line wins.
    """
    text = read_display_conf_raw(path)
    if text is None:
        return {}
    out = {}
    for section in parse_display_conf_raw(text).sections:
        if section.connector is None:
            continue
        entry = out.setdefault(section.connector, {})
        for raw in section.lines:
            key = line_key(raw)
            if key is None:
                continue
            val = raw.split('=', 1)[1].strip()
            if key == 'canvas_region':
                region = _parse_region(val)
                if region is not None:
                    entry.update(dict(zip(('x', 'y', 'width', 'height'),
                                          region)))
            elif key in ('resolution', 'refresh'):
                entry[key] = val
    return out


# ---------------------------------------------------------------------------
# Interactive helpers
# ---------------------------------------------------------------------------


def prompt(text, default=None):
    suffix = f' [{default}]' if default is not None else ''
    while True:
        try:
            answer = input(f'{text}{suffix}: ').strip()
        except EOFError:
            sys.exit('\nAborted.')
        if not answer and default is not None:
            return default
        if answer:
            return answer


def prompt_choice(text, options, default_idx=0):
    print()
    print(text)
    for i, opt in enumerate(options, start=1):
        marker = ' (default)' if i - 1 == default_idx else ''
        print(f'  {i}. {opt}{marker}')
    while True:
        raw = prompt(f'Pick 1-{len(options)}', default=str(default_idx + 1))
        try:
            idx = int(raw) - 1
        except ValueError:
            print(f'Not a number: {raw!r}')
            continue
        if 0 <= idx < len(options):
            return idx, options[idx]
        print(f'Out of range: {raw}')


def prompt_yes_no(text, default=True):
    suffix = 'Y/n' if default else 'y/N'
    while True:
        try:
            raw = input(f'{text} [{suffix}]: ').strip().lower()
        except EOFError:
            sys.exit('\nAborted.')
        if not raw:
            return default
        if raw in ('y', 'yes'):
            return True
        if raw in ('n', 'no'):
            return False


# ---------------------------------------------------------------------------
# Connector reorder
# ---------------------------------------------------------------------------


def reorder_connectors(outputs):
    """Let the operator reorder connectors to match physical L-to-R / T-to-B.

    DRM names sort lexicographically, which often does NOT match the lab's
    physical port layout. This step exists because a "horizontal" preset
    applied to a lexicographic order will mirror the canvas on hosts where
    physical order is reversed (slave: HDMI-A-3 is leftmost physically).
    """
    print()
    print('Connector order (canvas left-to-right / top-to-bottom):')
    for i, o in enumerate(outputs, start=1):
        label = o.get('edid_name') or '(no EDID)'
        print(f'  {i}. {o["connector"]:<12} {label}')
    print()
    print('Default order is lexicographic. If your physical port layout')
    print('differs (slave example: HDMI-A-3 leftmost), reorder now.')
    if prompt_yes_no('Keep this order?', default=True):
        return outputs

    print('Type "i j" to swap two positions; ENTER on its own when done.')
    work = list(outputs)
    while True:
        for i, o in enumerate(work, start=1):
            label = o.get('edid_name') or '(no EDID)'
            print(f'  {i}. {o["connector"]:<12} {label}')
        try:
            raw = input('swap (e.g. "1 3") or ENTER: ').strip()
        except EOFError:
            sys.exit('\nAborted.')
        if not raw:
            return work
        parts = raw.split()
        if len(parts) != 2:
            print('Need exactly two numbers.')
            continue
        try:
            a = int(parts[0]) - 1
            b = int(parts[1]) - 1
        except ValueError:
            print('Both must be integers.')
            continue
        if not (0 <= a < len(work) and 0 <= b < len(work)):
            print('Out of range.')
            continue
        work[a], work[b] = work[b], work[a]


# ---------------------------------------------------------------------------
# Resolution selection
# ---------------------------------------------------------------------------


PRESETS = [
    ('Native (each monitor at its preferred mode)', None),
    ('All 1080p (1920x1080)', '1920x1080'),
    ('All 720p (1280x720)', '1280x720'),
    ('Per-monitor (custom)', '__custom__'),
]


def select_resolutions(outputs, existing):
    """Return list of WxH strings, one per output (same order)."""
    idx, _ = prompt_choice('Resolution preset:', [p[0] for p in PRESETS], default_idx=0)
    _, target = PRESETS[idx]

    resolutions = []
    for o in outputs:
        existing_res = existing.get(o['connector'], {}).get('resolution')
        native = o['modes'][0] if o['modes'] else '1920x1080'
        if target is None:
            resolutions.append(native)
        elif target == '__custom__':
            print()
            label = o.get('edid_name') or '(no EDID)'
            print(f'{o["connector"]} ({label}):')
            for i, m in enumerate(o['modes'], start=1):
                marker = ' * native' if m == native else ''
                print(f'  {i}. {m}{marker}')
            default = existing_res or native
            try:
                default_idx = o['modes'].index(default) + 1
            except ValueError:
                default_idx = 1
            while True:
                raw = prompt(
                    f'Pick 1-{len(o["modes"])} or type WxH',
                    default=str(default_idx),
                )
                if re.match(r'^\d+x\d+$', raw):
                    resolutions.append(raw)
                    break
                try:
                    pick = int(raw) - 1
                    if 0 <= pick < len(o['modes']):
                        resolutions.append(o['modes'][pick])
                        break
                except ValueError:
                    pass
                print('Invalid pick.')
        else:
            if target in o['modes']:
                resolutions.append(target)
            else:
                print(f'WARNING: {o["connector"]} does not support {target}; '
                      f'using native {native}')
                resolutions.append(native)
    return resolutions


# ---------------------------------------------------------------------------
# Layout selection
# ---------------------------------------------------------------------------


def select_layout(outputs, resolutions):
    """Return list of (x, y, w, h) tuples in the same order as outputs."""
    layouts = [
        'Horizontal left-to-right',
        'Vertical top-to-bottom',
        'Manual (x,y per monitor)',
    ]
    idx, _ = prompt_choice('Layout:', layouts, default_idx=0)

    sizes = [tuple(int(p) for p in r.split('x')) for r in resolutions]

    if idx == 0:
        regions = []
        x = 0
        for w, h in sizes:
            regions.append((x, 0, w, h))
            x += w
        return regions
    if idx == 1:
        regions = []
        y = 0
        for w, h in sizes:
            regions.append((0, y, w, h))
            y += h
        return regions

    regions = []
    print()
    print('Enter x,y per monitor (e.g. "1920,540"):')
    for o, (w, h) in zip(outputs, sizes):
        label = o.get('edid_name') or '(no EDID)'
        while True:
            raw = prompt(
                f'  {o["connector"]} ({label}) {w}x{h} x,y',
                default='0,0',
            )
            if raw.count(',') != 1:
                print('Format: x,y (one comma).')
                continue
            try:
                x, y = (int(p.strip()) for p in raw.split(','))
            except ValueError:
                print('Both must be integers.')
                continue
            if x < 0 or y < 0:
                print('Negatives not allowed.')
                continue
            regions.append((x, y, w, h))
            break
    return regions


# ---------------------------------------------------------------------------
# Canvas size override
# ---------------------------------------------------------------------------


def select_canvas_size(regions):
    """Compute bbox; optionally let operator override to a larger canvas."""
    bbox_w = max(x + w for x, _, w, _ in regions)
    bbox_h = max(y + h for _, y, _, h in regions)
    print()
    print(f'Monitor bounding box: {bbox_w}x{bbox_h}')
    if not prompt_yes_no(
        'Override canvas size? (larger than bbox, e.g. for letterbox)',
        default=False,
    ):
        return None
    while True:
        raw = prompt(
            f'  canvas size (WxH, must be >= {bbox_w}x{bbox_h})',
            default=f'{bbox_w}x{bbox_h}',
        )
        m = re.match(r'^(\d+)x(\d+)$', raw)
        if not m:
            print('Format: WIDTHxHEIGHT.')
            continue
        cw, ch = int(m.group(1)), int(m.group(2))
        if cw < bbox_w or ch < bbox_h:
            print(f'Smaller than bbox ({bbox_w}x{bbox_h}) — would crop monitors.')
            continue
        if cw == bbox_w and ch == bbox_h:
            return None
        return (cw, ch)


# ---------------------------------------------------------------------------
# display.conf composition + install
# ---------------------------------------------------------------------------


def _ask_drop_section(connector):
    while True:
        answer = prompt(f'  {connector}: keep or drop its section?',
                        default='keep').strip().lower()
        if answer in ('keep', 'drop'):
            return answer == 'drop'
        print('Answer "keep" or "drop".')


def _ask_keep_line(connector, line):
    return prompt_yes_no(f'  {connector}: keep "{_printable(line)}"?',
                         default=True)


def review_existing_sections(conf, outputs, resolutions, regions,
                             ask_drop_section=None, ask_keep_line=None):
    """Decide, with the operator, about the lines this run does not own.

    Mutates `conf`:
    - a section whose connector is not detected now is KEPT verbatim, with a
      notice; only an explicit `drop` removes it (a projector that is off
      during a re-run is the normal case);
    - when an output's resolution or region changes, each carried `refresh=`
      and `blend=` line of that output is asked about (a carried refresh=
      next to a new resolution can select an interlaced mode or none; a
      carried blend= was set for the previous layout);
    - `color_*` lines are kept without a question (device calibration),
      with one notice per changed output.
    The askers are injectable for tests.
    """
    ask_drop_section = ask_drop_section or _ask_drop_section
    ask_keep_line = ask_keep_line or _ask_keep_line
    detected = {o['connector']: (res, tuple(region))
                for o, res, region in zip(outputs, resolutions, regions)}

    absent_answers = {}
    reviewed = set()
    for section in conf.sections:
        c = section.connector
        if c is None:
            continue
        if c not in detected:
            if c not in absent_answers:
                old = owned_values(section)
                where = _printable(old.get('canvas_region', 'none'))
                print(f'NOTICE: {c} not detected now -- section kept '
                      f'(canvas_region {where}); answer `drop` to remove it')
                absent_answers[c] = ask_drop_section(c)
            section.drop = absent_answers[c]
            if not section.drop and not owned_lines_are_canonical(section):
                print(f'NOTICE: {c}: spaced, indented or repeated '
                      f'{"/".join(OWNED_OUTPUT_KEYS)} lines rewritten as one '
                      'canonical line each (the value of the last one, as '
                      'the engine reads it)')
            continue
        if c in reviewed:
            # A duplicate section: its owned lines go, the rest is carried;
            # the first section of the connector got the questions.
            continue
        reviewed.add(c)
        new_res, new_region = detected[c]
        old = owned_values(section)
        old_res = old.get('resolution')
        old_region = _parse_region(old.get('canvas_region'))
        if old_res == new_res and old_region == new_region:
            continue
        change = _printable(f'{old_res or "-"} at {old_region or "-"} -> '
                            f'{new_res} at {new_region}')
        colour_keys = []
        for i, raw in enumerate(section.lines):
            key = line_key(raw)
            if key in GEOMETRY_BOUND_KEYS:
                line = raw.strip()
                if key == 'refresh':
                    why = ('with the new resolution it can select an '
                           'interlaced mode or none')
                else:
                    why = 'it was set for the previous layout'
                print(f'NOTICE: {c} changed ({change}); carried '
                      f'"{_printable(line)}": {why}')
                if not ask_keep_line(c, line):
                    section.dropped.add(i)
            elif key is not None and key.startswith(COLOR_KEY_PREFIX):
                colour_keys.append(key)
        if colour_keys:
            print(f'NOTICE: {c}: kept as they are (device calibration): '
                  f'{", ".join(colour_keys)}')


def _join_lines(lines):
    """Join raw lines; any line but the last gets a '\\n' if it has none."""
    out = []
    for i, line in enumerate(lines):
        if i < len(lines) - 1 and not line.endswith('\n'):
            line += '\n'
        out.append(line)
    return ''.join(out)


def compose_display_conf(outputs, resolutions, regions, canvas_size,
                         existing=None, timestamp=None):
    """Return the textual display.conf for the chosen layout.

    `existing` is the RawDisplayConf of the current file (after
    review_existing_sections), or None for a fresh file. Owned lines are
    written canonical (column 0, '\\n'-terminated) where the first owned
    line of their block was; everything else is carried verbatim, in place.
    The tool's own lines always end in '\\n', even in a CRLF file: the VC
    compares some values untrimmed (`canvas_layout=custom\\r` is not
    "custom").
    """
    ts = timestamp or datetime.datetime.now().isoformat(timespec='seconds')
    owned_global = ['canvas_layout=custom\n']
    if canvas_size is not None:
        owned_global.append(f'canvas_size={canvas_size[0]}x{canvas_size[1]}\n')
    owned_output = {}
    for o, res, (x, y, w, h) in zip(outputs, resolutions, regions):
        owned_output[o['connector']] = [f'canvas_region={x},{y},{w},{h}\n',
                                        f'resolution={res}\n']

    lines = [f'{AUTHORED_HEADER_PREFIX} on {ts}\n']

    if existing is None:
        lines += owned_global + ['\n']
        sections = []
    else:
        carried = []
        anchor = None
        for raw in existing.preamble:
            if raw.strip().startswith(AUTHORED_HEADER_PREFIX):
                continue  # the header is rewritten once, never stacked
            if line_key(raw) in OWNED_GLOBAL_KEYS:
                if anchor is None:
                    anchor = len(carried)
                continue
            carried.append(raw)
        if anchor is None:
            anchor = 0
        carried[anchor:anchor] = owned_global
        lines += carried
        sections = existing.sections

    written = set()
    for section in sections:
        if section.drop:
            continue
        c = section.connector
        if c is None:
            # Not an [output:] section: verbatim.
            lines.append(section.header)
            lines += section.lines
            continue
        if c not in owned_output:
            # Not detected now: kept, verbatim unless its owned lines were
            # not canonical (a spaced copy must never be carried, r7).
            lines.append(section.header)
            lines += canonical_carried_lines(section)
            continue
        body = []
        anchor = None
        for i, raw in enumerate(section.lines):
            if line_key(raw) in OWNED_OUTPUT_KEYS:
                if anchor is None:
                    anchor = len(body)
                continue
            if i in section.dropped:
                continue
            body.append(raw)
        if c not in written:
            body[anchor or 0:anchor or 0] = owned_output[c]
            written.add(c)
        lines.append(section.header)
        lines += body

    for o in outputs:
        c = o['connector']
        if c in written:
            continue
        if lines and lines[-1].strip():
            lines.append('\n')  # blank line between sections
        lines.append(f'[output:{c}]\n')
        lines += owned_output[c]
        written.add(c)

    return _join_lines(lines)


def install_display_conf(content, no_backup=False):
    """Atomic write to /etc/cuems/display.conf with optional backup.

    Temp file lives in /etc/cuems/.display.conf.tmp.<pid> (same FS as
    destination so os.rename succeeds — cross-filesystem rename fails
    with EXDEV).
    """
    target = DISPLAY_CONF
    target_dir = os.path.dirname(target)
    os.makedirs(target_dir, exist_ok=True)
    if os.path.isfile(target) and not no_backup:
        ts = datetime.datetime.now().strftime('%Y-%m-%dT%H-%M-%S')
        backup = f'{target}.bak-{ts}'
        shutil.copy2(target, backup)
        print(f'Backed up previous display.conf to {backup}')
    tmp = os.path.join(target_dir, f'.display.conf.tmp.{os.getpid()}')
    # newline='': no translation, so carried CRLF lines stay CRLF and the
    # tool's own lines stay LF.
    with open(tmp, 'w', encoding=CONF_ENCODING, errors=CONF_ERRORS,
              newline='') as f:
        f.write(content)
    os.chmod(tmp, 0o644)
    os.rename(tmp, target)
    print(f'Wrote {target}')


# ---------------------------------------------------------------------------
# Service restart
# ---------------------------------------------------------------------------


def is_controller_host():
    return os.path.isfile(MASTER_IP_SENTINEL)


def restart_services():
    """Restart VC + engine(s). VC first so /run/ is regenerated from /etc/."""
    units = ['cuems-videocomposer.service']
    if is_controller_host():
        units.extend(['cuems-controller-engine.service', 'cuems-node-engine.service'])
    else:
        units.append('cuems-node-engine.service')
    print(f'Restarting (in order): {", ".join(units)}')
    for u in units:
        subprocess.run(['systemctl', 'restart', u], check=True)
        print(f'  restarted {u}')


# ---------------------------------------------------------------------------
# --update-mappings: surgical insert into default_mappings.xml
# ---------------------------------------------------------------------------


def _connectors_in_default_mappings():
    if not os.path.isfile(DEFAULT_MAPPINGS_XML):
        return set()
    try:
        tree = ET.parse(DEFAULT_MAPPINGS_XML)
    except ET.ParseError:
        return set()
    out = set()
    for mapped in tree.iterfind('.//video/outputs/output/mappings/mapped_to'):
        if mapped.text:
            out.add(mapped.text.strip())
    return out


def update_default_mappings(connector, name):
    """Insert a new <output> into the local node's <video><outputs>.

    Surgical edit via ElementTree; preserves most formatting. Schema
    order under VideoPutType: <id>, <name>, optional <canvas_region>,
    <mappings>. We omit canvas_region (UI-template hint only, see XSD).
    """
    if not os.path.isfile(DEFAULT_MAPPINGS_XML):
        sys.exit(f'ERROR: {DEFAULT_MAPPINGS_XML} not found')

    ET.register_namespace('cms', CMS_NAMESPACE)
    ET.register_namespace('xsi', 'http://www.w3.org/2001/XMLSchema-instance')
    tree = ET.parse(DEFAULT_MAPPINGS_XML)
    root = tree.getroot()

    settings_path = SETTINGS_XML
    local_uuid = None
    if os.path.isfile(settings_path):
        try:
            stree = ET.parse(settings_path)
            uel = stree.find('.//Settings/node/uuid')
            if uel is not None and uel.text:
                local_uuid = uel.text.strip()
        except ET.ParseError:
            pass

    target_node = None
    for node_el in root.findall('.//nodes/node'):
        ue = node_el.find('uuid')
        if ue is not None and ue.text and (local_uuid is None
                                           or ue.text.strip() == local_uuid):
            target_node = node_el
            break
    if target_node is None:
        sys.exit('ERROR: could not find local node in default_mappings.xml')

    outputs_el = target_node.find('./video/outputs')
    if outputs_el is None:
        sys.exit('ERROR: <video><outputs> missing under local node')

    for out_el in outputs_el.findall('./output'):
        mapped = out_el.find('mappings/mapped_to')
        if mapped is not None and mapped.text and mapped.text.strip() == connector:
            print(f'Connector {connector} already in default_mappings.xml (skipping)')
            return

    existing_ids = []
    for out_el in outputs_el.findall('./output'):
        ie = out_el.find('id')
        if ie is not None and ie.text:
            try:
                existing_ids.append(int(ie.text))
            except ValueError:
                pass
    next_id = max(existing_ids) + 1 if existing_ids else 0

    new_out = ET.SubElement(outputs_el, 'output')
    id_el = ET.SubElement(new_out, 'id')
    id_el.text = str(next_id)
    name_el = ET.SubElement(new_out, 'name')
    name_el.text = name
    mappings_el = ET.SubElement(new_out, 'mappings')
    mapped_el = ET.SubElement(mappings_el, 'mapped_to')
    mapped_el.text = connector

    # Write a temp file next to the target, validate THAT, and only then
    # rename it into place: a failed validation leaves the original as it
    # was, and nothing is half-written.
    ET.indent(tree, space='    ')
    tmp = f'{DEFAULT_MAPPINGS_XML}.tmp.{os.getpid()}'
    try:
        tree.write(tmp, xml_declaration=True, encoding='utf-8')
        if validate_mappings_xml(tmp) is False:
            os.unlink(tmp)
            sys.exit(f'ERROR: {DEFAULT_MAPPINGS_XML} NOT changed '
                     '(the edited XML fails the schema)')
        ts = datetime.datetime.now().strftime('%Y-%m-%dT%H-%M-%S')
        backup = f'{DEFAULT_MAPPINGS_XML}.bak-{ts}'
        shutil.copy2(DEFAULT_MAPPINGS_XML, backup)
        print(f'Backed up XML to {backup}')
        os.rename(tmp, DEFAULT_MAPPINGS_XML)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    print(f'Wrote {DEFAULT_MAPPINGS_XML} (id={next_id}, name={name!r}, mapped_to={connector})')


def find_project_mappings_xsd():
    """Return the venv's project_mappings.xsd, or None when absent."""
    if os.path.isfile(PROJECT_MAPPINGS_XSD):
        return PROJECT_MAPPINGS_XSD
    matches = sorted(glob.glob(PROJECT_MAPPINGS_XSD_GLOB))
    return matches[0] if matches else None


def validate_mappings_xml(xml_path):
    """Validate against the venv schema with xmllint.

    Returns True (valid), False (invalid, xmllint's errors printed) or None
    (skipped with a notice: the schema or xmllint is not installed).
    """
    xsd = find_project_mappings_xsd()
    if xsd is None:
        print(f'NOTICE: schema not found ({PROJECT_MAPPINGS_XSD}); '
              'skipping validation')
        return None
    try:
        result = subprocess.run(
            ['xmllint', '--noout', '--schema', xsd, xml_path],
            capture_output=True,
            text=True,
        )
    except OSError as e:  # FileNotFoundError: xmllint is not installed
        print(f'NOTICE: cannot run xmllint ({e}); skipping validation '
              '(xmllint is in the libxml2-utils package)')
        return None
    if result.returncode != 0:
        print(f'ERROR: xmllint --schema {xsd} failed:')
        print(result.stderr)
        return False
    print(f'xmllint --schema passed ({xsd})')
    return True


# ---------------------------------------------------------------------------
# Show-lock guard
# ---------------------------------------------------------------------------


def check_show_lock(force):
    """Refuse to proceed if the show lock is present.

    /tmp/cuems.show.lock is set by BaseEngine.set_show_lock_file() when a
    project is loaded — its presence means there's an active show. Per
    project rule "Never auto-stop a running project", we refuse install
    + restart in this state. --force lets the operator override
    explicitly (they're saying "I know what I'm doing").
    """
    if not os.path.isfile(SHOW_LOCK_PATH):
        return
    if force:
        print(f'WARNING: {SHOW_LOCK_PATH} exists (project loaded). --force given; proceeding anyway.')
        return
    sys.exit(
        f'ERROR: {SHOW_LOCK_PATH} exists — a project is currently loaded.\n'
        '       Refusing to install / restart while a show is active.\n'
        '       Stop playback and unload the project first, then re-run.\n'
        '       (Use --force to override at your own risk.)'
    )


# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------


def cmd_probe(args):
    outputs = probe_connected_outputs()
    if not outputs:
        print('No connected DRM outputs found.', file=sys.stderr)
        return 1
    for o in outputs:
        label = o.get('edid_name') or '(no EDID)'
        modes = ', '.join(o['modes']) if o['modes'] else '(no modes)'
        print(f'{o["card"]}/{o["connector"]:<12}  {label}')
        print(f'  modes: {modes}')
    return 0


def cmd_interactive(args):
    check_show_lock(args.force)

    outputs = probe_connected_outputs()
    if not outputs:
        sys.exit('No connected DRM outputs found.')

    print(f'Detected {len(outputs)} connected output(s):')
    for o in outputs:
        label = o.get('edid_name') or '(no EDID)'
        native = o['modes'][0] if o['modes'] else '?'
        print(f'  {o["connector"]:<12}  native {native:<10}  {label}')

    if args.update_mappings:
        xml_known = _connectors_in_default_mappings()
        for o in outputs:
            if o['connector'] not in xml_known:
                label = o.get('edid_name') or o['connector']
                friendly = prompt(
                    f'  add {o["connector"]} to default_mappings.xml as <name>',
                    default=label,
                )
                update_default_mappings(o['connector'], friendly)

    existing = load_existing_display_conf()
    existing_text = read_display_conf_raw()
    existing_conf = None
    if existing_text is not None:
        existing_conf = parse_display_conf_raw(existing_text)
        if '\r\n' in existing_text:
            print(f'NOTICE: {DISPLAY_CONF} has CRLF line endings. Its lines are '
                  'carried as they are, but the VC keeps the \\r in values '
                  '(enabled=true\\r reads as false); consider dos2unix.')
    outputs = reorder_connectors(outputs)
    resolutions = select_resolutions(outputs, existing)
    regions = select_layout(outputs, resolutions)
    canvas_size = select_canvas_size(regions)

    if existing_conf is not None:
        print()
        review_existing_sections(existing_conf, outputs, resolutions, regions)
    content = compose_display_conf(outputs, resolutions, regions, canvas_size,
                                   existing=existing_conf)
    print()
    print('=' * 60)
    print(_printable(content), end='')
    print('=' * 60)

    if args.no_install or args.dry_run:
        print('(no-install: not writing)')
        return 0

    if not prompt_yes_no('Install this display.conf?', default=True):
        print('Aborted; no changes.')
        return 0

    install_display_conf(content, no_backup=args.no_backup)

    if args.no_restart:
        print('(--no-restart: change picks up at next cuems-videocomposer start)')
        return 0
    if not args.restart and not prompt_yes_no('Restart services now?', default=True):
        print('(skip restart — change picks up at next cuems-videocomposer start)')
        return 0
    restart_services()
    return 0


def main():
    parser = argparse.ArgumentParser(
        description='Interactive operator tool for /etc/cuems/display.conf'
    )
    parser.add_argument('--probe', action='store_true',
                        help='print connected outputs + modes and exit')
    parser.add_argument('--update-mappings', action='store_true',
                        help='also patch default_mappings.xml for new connectors')
    parser.add_argument('--no-install', action='store_true',
                        help='preview only, do not touch /etc/cuems/display.conf')
    parser.add_argument('--dry-run', action='store_true',
                        help='like --no-install but also skip backup')
    parser.add_argument('--restart', action='store_true',
                        help='restart services after install (skip confirm prompt)')
    parser.add_argument('--no-restart', action='store_true',
                        help='do not restart services')
    parser.add_argument('--no-backup', action='store_true',
                        help='skip the display.conf.bak-* file')
    parser.add_argument('--force', action='store_true',
                        help='proceed even if a show is loaded (overrides show.lock check)')
    args = parser.parse_args()

    if args.probe:
        # --probe is read-only and doesn't need root.
        return cmd_probe(args)
    if os.getuid() != 0:
        sys.exit('cuems-display-setup must run as root for install (use sudo)')
    return cmd_interactive(args)


if __name__ == '__main__':
    sys.exit(main())
