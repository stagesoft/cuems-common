#!/usr/bin/env python3
"""Detect DRM connector → GPU pipe → ALSA device mapping and generate asound.conf.

On Intel Alder Lake, the GPU assigns display pipes (CRTCs) to physical ports
dynamically at boot. The HDA HDMI audio codec maps pipes to fixed ALSA devices:

    Pipe A (CRTC index 0) → device 3
    Pipe B (CRTC index 1) → device 7
    Pipe C (CRTC index 2) → device 8

This script reads the current CRTC→connector assignment via DRM ioctls,
builds the mapping, and writes /etc/asound.conf so that physical ports
always map to the same JACK channel pairs regardless of boot order.

The ALSA *card* is detected, never assumed. It is called "PCH" on the Intel
N97/N100 nodes but "Generic" on the AMD boxes, and writing the Intel name into
the config on an AMD host produces "Cannot get card index for PCH" - at which
point jackd cannot open a device, crash-loops, and takes cuems-node-engine
down with it as a failed dependency. The device numbers themselves (3, 7, 8)
are a property of the HDA codec layout and are the same on both.

Connector ordering (determines JACK channel assignment):
    Slot a (ch 1-2) = first connected port  (alphabetical by DRM name)
    Slot b (ch 3-4) = second connected port
    Slot c (ch 5-6) = third connected port  (if any)
"""

import ctypes
import struct
import os
import re
import sys
import fcntl
import array
import logging

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')
log = logging.getLogger('cuems-hdmi-audio-map')

ASOUND_CONF = '/etc/asound.conf'

# Intel Alder Lake HDA HDMI: pipe index → ALSA device number
PIPE_TO_DEVICE = {0: 3, 1: 7, 2: 8}

# Card name used only when detection finds nothing at all - the historical
# Intel value, so a host that somehow reports no HDMI PCMs behaves exactly as
# it did before this was made portable.
FALLBACK_CARD = 'PCH'


def detect_hda_card():
    """Return the ALSA card name that carries the HDMI playback devices.

    Read out of /proc/asound rather than assumed, because the name is a
    property of the machine: "PCH" on Intel, "Generic" on the AMD boxes. A
    card is the right one when it has playback PCMs describing themselves as
    HDMI - which also skips the analog codec (ALC897) that sits on its own
    card and would otherwise be an equally plausible guess.
    """
    try:
        entries = sorted(os.listdir('/proc/asound'))
    except OSError as e:
        log.warning(f'cannot read /proc/asound ({e}) - assuming card {FALLBACK_CARD}')
        return FALLBACK_CARD

    for entry in entries:
        if not re.fullmatch(r'card\d+', entry):
            continue
        base = f'/proc/asound/{entry}'
        try:
            card_id = open(f'{base}/id').read().strip()
        except OSError:
            continue

        hdmi_devices = set()
        try:
            subs = os.listdir(base)
        except OSError:
            continue
        for sub in subs:
            m = re.fullmatch(r'pcm(\d+)p', sub)
            if not m:
                continue
            try:
                info = open(f'{base}/{sub}/info').read()
            except OSError:
                continue
            if 'HDMI' in info:
                hdmi_devices.add(int(m.group(1)))

        if hdmi_devices:
            log.info(f'ALSA card for HDMI audio: {card_id} '
                     f'(devices {sorted(hdmi_devices)})')
            missing = sorted(set(PIPE_TO_DEVICE.values()) - hdmi_devices)
            if missing:
                # Not fatal - the config still generates - but it means a slot
                # will point at a PCM this machine does not have.
                log.warning(f'card {card_id} lacks expected HDMI device(s) {missing}; '
                            f'the generated slots for them will not open')
            return card_id

    log.warning(f'no HDMI playback devices found in /proc/asound - '
                f'assuming card {FALLBACK_CARD}')
    return FALLBACK_CARD

# DRM connector type constants
CONNECTOR_TYPES = {
    1: 'VGA', 2: 'DVI-I', 3: 'DVI-D', 4: 'DVI-A', 5: 'Composite',
    6: 'SVIDEO', 7: 'LVDS', 8: 'Component', 9: '9PinDIN', 10: 'DP',
    11: 'HDMI-A', 12: 'HDMI-B', 13: 'TV', 14: 'eDP', 15: 'Virtual',
    16: 'DSI', 17: 'DPI', 18: 'Writeback', 19: 'SPI', 20: 'USB',
}

DRM_IOCTL_MODE_GETRESOURCES = 0xC04064A0
DRM_IOCTL_MODE_GETCONNECTOR = 0xC05064A7
DRM_IOCTL_MODE_GETENCODER = 0xC01464A6


def drm_get_resources(fd):
    """Get DRM resource IDs (CRTCs, connectors, encoders)."""
    buf = bytearray(64)
    struct.pack_into('QQQQ', buf, 0, 0, 0, 0, 0)
    struct.pack_into('IIII', buf, 32, 0, 0, 0, 0)
    fcntl.ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, buf)

    _, count_crtcs, count_connectors, count_encoders = struct.unpack_from('IIII', buf, 32)

    crtc_ids = array.array('I', [0] * count_crtcs)
    conn_ids = array.array('I', [0] * count_connectors)
    enc_ids = array.array('I', [0] * count_encoders)

    crtc_ptr, _ = crtc_ids.buffer_info()
    conn_ptr, _ = conn_ids.buffer_info()
    enc_ptr, _ = enc_ids.buffer_info()

    buf2 = bytearray(64)
    struct.pack_into('QQQQ', buf2, 0, 0, crtc_ptr, conn_ptr, enc_ptr)
    struct.pack_into('IIII', buf2, 32, 0, count_crtcs, count_connectors, count_encoders)
    fcntl.ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, buf2)

    return list(crtc_ids), list(conn_ids), list(enc_ids)


def drm_get_connector(fd, conn_id):
    """Get connector type, type_id, encoder_id, and connection status."""
    buf = bytearray(80)
    struct.pack_into('QQQQ', buf, 0, 0, 0, 0, 0)
    struct.pack_into('III', buf, 32, 0, 0, 0)
    struct.pack_into('IIII', buf, 44, 0, conn_id, 0, 0)
    fcntl.ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, buf)

    encoder_id = struct.unpack_from('I', buf, 44)[0]
    conn_type = struct.unpack_from('I', buf, 52)[0]
    conn_type_id = struct.unpack_from('I', buf, 56)[0]
    connection = struct.unpack_from('I', buf, 60)[0]

    type_name = CONNECTOR_TYPES.get(conn_type, f'Unknown-{conn_type}')
    name = f'{type_name}-{conn_type_id}'
    connected = (connection == 1)

    return name, encoder_id, connected


def drm_get_encoder(fd, enc_id):
    """Get encoder's assigned CRTC ID."""
    buf = bytearray(24)
    struct.pack_into('I', buf, 0, enc_id)
    fcntl.ioctl(fd, DRM_IOCTL_MODE_GETENCODER, buf)
    crtc_id = struct.unpack_from('I', buf, 8)[0]
    return crtc_id


def detect_mapping():
    """Return list of (connector_name, alsa_device) sorted by connector name."""
    fd = os.open('/dev/dri/card0', os.O_RDWR)
    try:
        crtc_ids, conn_ids, enc_ids = drm_get_resources(fd)
        log.info(f'CRTCs: {crtc_ids}')

        # Build CRTC ID → pipe index map
        crtc_to_pipe = {cid: idx for idx, cid in enumerate(crtc_ids)}

        mapping = []
        for cid in conn_ids:
            name, encoder_id, connected = drm_get_connector(fd, cid)
            if not connected or encoder_id == 0:
                log.info(f'  {name}: disconnected')
                continue

            crtc_id = drm_get_encoder(fd, encoder_id)
            pipe_idx = crtc_to_pipe.get(crtc_id)

            if pipe_idx is None:
                log.warning(f'  {name}: connected but CRTC {crtc_id} not in resource list')
                continue

            device = PIPE_TO_DEVICE.get(pipe_idx)
            if device is None:
                log.warning(f'  {name}: pipe {pipe_idx} has no known audio device')
                continue

            log.info(f'  {name}: CRTC {crtc_id} → pipe {pipe_idx} → device {device}')
            mapping.append((name, device))

    finally:
        os.close(fd)

    # Sort by connector name for stable channel ordering
    mapping.sort(key=lambda x: x[0])
    return mapping


def jack_device_hint(path='/etc/default/jack'):
    """One-line description of the ALSA device jackd is configured to open.

    Read from DAEMON_ARGS in /etc/default/jack, which is a plain conffile and is
    NOT regenerated at boot — unlike asound.conf. Used only to make the generated
    header honest about where audio actually goes; never to change behaviour.
    """
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError:
        return f'DAEMON_ARGS unreadable ({path}) — check it by hand'
    m = re.search(r'^\s*DAEMON_ARGS\s*=\s*"([^"]*)"', text, re.M)
    if not m:
        return f'no DAEMON_ARGS found in {path} — check it by hand'
    args = m.group(1)
    dev = re.search(r'-d\s*(hw:[^\s"]+|[A-Za-z_][\w:.,-]*)', args[args.find('-dalsa') + 6:]
                    if '-dalsa' in args else args)
    if not dev:
        return f'DAEMON_ARGS={args} (no -d device found)'
    d = dev.group(1)
    note = ''
    if re.fullmatch(r'hw:(PCH|Generic\w*|0),0', d):
        note = '  <-- ALC897 analog / minijack, NOT HDMI'
    elif 'multi_hdmi' in d or 'hdmi' in d.lower():
        note = '  <-- the HDMI slots defined below'
    return f'jackd -d {d}{note}'


def generate_asound_conf(mapping, card):
    """Generate asound.conf content from the detected mapping.

    Always produces 3 slots (6 channels) for JACK stability.
    Connected ports are assigned first (sorted alphabetically),
    then remaining ALSA devices fill the unused slots.

    `card` is the ALSA card name detected on this machine; it is never
    hardcoded, because it differs between the Intel and AMD nodes.
    """
    ALL_DEVICES = sorted(PIPE_TO_DEVICE.values())  # [3, 7, 8]
    SLOT_COUNT = len(ALL_DEVICES)
    slot_names = ['a', 'b', 'c']

    # Connected ports get priority slots; remaining devices fill the rest
    used_devices = {dev for _, dev in mapping}
    spare_devices = sorted(d for d in ALL_DEVICES if d not in used_devices)

    slots = []  # list of (label, device)
    for conn_name, dev in mapping[:SLOT_COUNT]:
        slots.append((conn_name, dev))
    for dev in spare_devices:
        if len(slots) >= SLOT_COUNT:
            break
        slots.append((f'(unused, hw:{card},{dev})', dev))

    # Header comment
    lines = [
        '# Auto-generated by cuems-hdmi-audio-map',
        '# DO NOT EDIT — regenerated at every boot',
        '#',
        '# Detected mapping (physical port → ALSA device):',
    ]
    for i, (label, dev) in enumerate(slots):
        slot = slot_names[i]
        lines.append(f'#   slot {slot} (ch {i*2+1}-{i*2+2}) = {label} → hw:{card},{dev}')
    lines.append('#')
    lines.append('#   hw:HID,0  = USB Audio (bridged via alsa_out)')
    lines.append('#')
    # Do NOT assert that JACK uses multi_hdmi: this script neither decides that nor
    # can know it. JACK's device comes from DAEMON_ARGS in /etc/default/jack, and a
    # venue whose sound goes to a house PA rather than the projectors runs jackd on
    # the analog output instead — cupula2 runs -dhw:PCH,0 (the ALC897 minijack) with
    # every HDMI PCM closed. The old unconditional "JACK runs on multi_hdmi" line was
    # simply false on such a host and sent anyone debugging audio to the wrong
    # device, so report the configured value instead of assuming one.
    lines.append('# multi_hdmi (6ch) is DEFINED here; whether JACK actually uses it')
    lines.append('# is decided by DAEMON_ARGS in /etc/default/jack, not by this file:')
    lines.append(f'#   {jack_device_hint()}')
    lines.append('# USB audio, if used, is bridged separately (jack-alsa-bridges).')
    lines.append('')

    # multi_hdmi PCM
    lines.append('pcm.multi_hdmi {')
    lines.append('    type multi')
    lines.append('')
    lines.append('    slaves {')
    for i, (label, dev) in enumerate(slots):
        slot = slot_names[i]
        lines.append(f'        {slot} {{ pcm "hw:{card},{dev}" channels 2 }}')
    lines.append('    }')
    lines.append('')
    lines.append('    bindings {')
    for i in range(len(slots)):
        slot = slot_names[i]
        lines.append(f'        {i*2} {{ slave {slot} channel 0 }}')
        lines.append(f'        {i*2+1} {{ slave {slot} channel 1 }}')
    lines.append('    }')
    lines.append('}')
    lines.append('')

    # Convenience plug device
    lines.append('pcm.hdmi_all {')
    lines.append('    type plug')
    lines.append('    slave.pcm "multi_hdmi"')
    lines.append('}')
    lines.append('')

    return '\n'.join(lines)


def main():
    dry_run = '--dry-run' in sys.argv or '-n' in sys.argv

    mapping = detect_mapping()

    if not mapping:
        log.error('No HDMI/DP audio outputs detected. Leaving asound.conf unchanged.')
        sys.exit(1)

    card = detect_hda_card()
    conf = generate_asound_conf(mapping, card)

    if dry_run:
        print(conf)
    else:
        log.info(f'Writing {ASOUND_CONF} with {len(mapping)} output(s)')
        with open(ASOUND_CONF, 'w') as f:
            f.write(conf)
        log.info('Done.')


if __name__ == '__main__':
    main()
