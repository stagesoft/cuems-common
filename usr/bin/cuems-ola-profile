#!/bin/bash
set -euo pipefail
trap 'echo "ERROR: Script interrupted, OLA config may be inconsistent. Check /etc/ola/ manually." >&2; exit 1' INT TERM

CONF_DIR="/etc/ola"
ADDITIVE=false

usage() {
    echo "Usage: cuems-ola-profile [--add] <profile> [<profile>...]"
    echo "Profiles: pro, opendmx, eurolite-mk2, artnet, sacn"
    echo "  --add   Add to current config instead of resetting all plugins first"
    echo ""
    echo "All profiles enable ArtNet + sACN (E1.31) by default (no conflicts)."
    echo ""
    echo "Examples:"
    echo "  cuems-ola-profile pro              # Enttec Pro/DMXking + ArtNet + sACN"
    echo "  cuems-ola-profile opendmx          # Enttec Open DMX + ArtNet + sACN"
    echo "  cuems-ola-profile eurolite-mk2     # Eurolite USB-DMX512 PRO MK2 (auto-detects FTDI serial)"
    echo "  cuems-ola-profile eurolite-mk2:SERIAL  # ...or pin an explicit FTDI serial"
    echo "  cuems-ola-profile artnet            # Network-only (ArtNet + sACN)"
    echo ""
    echo "Plugin compatibility:"
    echo "  - 'pro' and 'opendmx' are MUTUALLY EXCLUSIVE (usbpro vs ftdidmx conflict)"
    echo "  - 'eurolite-mk2' is MUTUALLY EXCLUSIVE with pro/opendmx (FTDI device contention)"
    echo "  - ArtNet and sACN are always enabled (safe with all profiles)"
    exit 1
}

enable_plugin() {
    local conf="$CONF_DIR/$1"
    if [[ ! -f "$conf" ]]; then
        echo "WARNING: $conf not found, skipping" >&2
        return
    fi
    sed -i 's/^enabled = false/enabled = true/' "$conf"
}

disable_all_plugins() {
    for f in "$CONF_DIR"/ola-*.conf; do
        case "$(basename "$f")" in
            ola-server.conf|ola-port.conf|ola-universe.conf) continue ;;
            *) sed -i 's/^enabled = true/enabled = false/' "$f" ;;
        esac
    done
}

# Print the serial of every connected FTDI FT232R (VID 0403 / PID 6001),
# one per line. That is how the Eurolite USB-DMX512 PRO MK2 enumerates
# (stock FTDI EEPROM), so we use it to auto-pin eurolite_mk2_serial.
detect_mk2_serials() {
    local d v p ser
    for d in /sys/bus/usb/devices/*/; do
        [[ -r "$d/idVendor" && -r "$d/idProduct" ]] || continue
        v=$(cat "$d/idVendor" 2>/dev/null || true)
        p=$(cat "$d/idProduct" 2>/dev/null || true)
        [[ "$v" == "0403" && "$p" == "6001" ]] || continue
        ser=$(cat "$d/serial" 2>/dev/null || true)
        [[ -n "$ser" ]] && echo "$ser"
    done
}

[[ $# -eq 0 ]] && usage

# Parse --add flag (can appear anywhere)
PROFILES=()
for arg in "$@"; do
    if [[ "$arg" == "--add" ]]; then
        ADDITIVE=true
    else
        PROFILES+=("$arg")
    fi
done

[[ ${#PROFILES[@]} -eq 0 ]] && usage

# Conflict check: pro and opendmx are mutually exclusive
HAS_PRO=false
HAS_OPENDMX=false
HAS_MK2=false
for profile in "${PROFILES[@]}"; do
    case "$profile" in
        pro) HAS_PRO=true ;;
        opendmx) HAS_OPENDMX=true ;;
        eurolite-mk2|eurolite-mk2:*) HAS_MK2=true ;;
    esac
done
if $HAS_PRO && $HAS_OPENDMX; then
    echo "ERROR: 'pro' and 'opendmx' are mutually exclusive (usbpro vs ftdidmx conflict)" >&2
    exit 1
fi
if $HAS_MK2 && { $HAS_PRO || $HAS_OPENDMX; }; then
    echo "ERROR: 'eurolite-mk2' is mutually exclusive with pro/opendmx (FTDI device contention)" >&2
    exit 1
fi

# Reset unless additive
if [[ "$ADDITIVE" == false ]]; then
    echo "Disabling all plugins..."
    disable_all_plugins
fi

# Always enable network protocols (no conflicts with anything)
echo "Enabling ArtNet + sACN (always on)..."
enable_plugin "ola-artnet.conf"
enable_plugin "ola-e131.conf"

for profile in "${PROFILES[@]}"; do
    case "$profile" in
        pro)
            echo "Enabling profile: pro (Enttec Pro / DMXking)"
            enable_plugin "ola-usbserial.conf"
            enable_plugin "ola-usbdmx.conf"
            # usbpro needs ftdi_sio — remove blacklist if present
            if [[ -f /etc/modprobe.d/blacklist-ftdi.conf ]]; then
                rm -f /etc/modprobe.d/blacklist-ftdi.conf
                modprobe ftdi_sio 2>/dev/null || true
                echo "  Removed ftdi_sio blacklist and loaded module."
            fi
            ;;
        opendmx)
            echo "Enabling profile: opendmx (Enttec Open DMX)"
            enable_plugin "ola-ftdidmx.conf"
            enable_plugin "ola-usbdmx.conf"
            # ftdidmx needs ftdi_sio OUT — blacklist it
            # WARNING: this affects ALL FTDI serial devices on this machine
            echo "blacklist ftdi_sio" > /etc/modprobe.d/blacklist-ftdi.conf
            if ! modprobe -r ftdi_sio 2>/dev/null; then
                echo "  WARNING: Could not unload ftdi_sio (device may be in use)." >&2
                echo "  A reboot is required for the blacklist to take effect." >&2
            else
                echo "  Blacklisted and unloaded ftdi_sio."
            fi
            ;;
        eurolite-mk2|eurolite-mk2:*)
            # Eurolite USB-DMX512 PRO MK2: presents as a stock FTDI FT232R
            # (VID 0403 / PID 6001). The usbdmx EurolitePro factory claims it
            # when enable_eurolite_mk2=true OR the device serial is pinned via
            # eurolite_mk2_serial. With no explicit "eurolite-mk2:<serial>" we
            # auto-detect the connected FT232R and pin its serial.
            MK2_SERIAL="${profile#eurolite-mk2}"
            MK2_SERIAL="${MK2_SERIAL#:}"
            echo "Enabling profile: eurolite-mk2 (Eurolite USB-DMX512 PRO MK2)"
            enable_plugin "ola-usbdmx.conf"
            USBDMX_CONF="$CONF_DIR/ola-usbdmx.conf"
            if [[ -z "$MK2_SERIAL" ]]; then
                mapfile -t MK2_FOUND < <(detect_mk2_serials)
                if [[ ${#MK2_FOUND[@]} -eq 1 ]]; then
                    MK2_SERIAL="${MK2_FOUND[0]}"
                    echo "  Auto-detected FTDI FT232R serial: $MK2_SERIAL"
                elif [[ ${#MK2_FOUND[@]} -gt 1 ]]; then
                    echo "ERROR: multiple FTDI FT232R devices found: ${MK2_FOUND[*]}" >&2
                    echo "  Pin one explicitly: cuems-ola-profile eurolite-mk2:<serial>" >&2
                    exit 1
                else
                    echo "  No FTDI FT232R (0403:6001) connected; enabling global MK2"
                    echo "  detection so the device is claimed once plugged in."
                fi
            fi
            if [[ -n "$MK2_SERIAL" ]]; then
                sed -i "s/^eurolite_mk2_serial = .*/eurolite_mk2_serial = $MK2_SERIAL/" "$USBDMX_CONF"
                sed -i 's/^enable_eurolite_mk2 = true/enable_eurolite_mk2 = false/' "$USBDMX_CONF"
                echo "  Pinned MK2 by FTDI serial: $MK2_SERIAL"
            else
                sed -i 's/^enable_eurolite_mk2 = false/enable_eurolite_mk2 = true/' "$USBDMX_CONF"
                sed -i 's/^eurolite_mk2_serial = .*/eurolite_mk2_serial =/' "$USBDMX_CONF"
                echo "  Enabled global MK2 detection (any FTDI FT232R)."
            fi
            # ftdidmx / usbserial(usbpro) / stageprofi contend for the same FTDI
            # device; force them off even in --add mode.
            for c in ola-ftdidmx.conf ola-usbserial.conf ola-stageprofi.conf; do
                [[ -f "$CONF_DIR/$c" ]] && sed -i 's/^enabled = true/enabled = false/' "$CONF_DIR/$c"
            done
            ;;
        artnet)
            # Already enabled above, this profile just means no USB DMX
            echo "Enabling profile: artnet (network-only)"
            ;;
        sacn)
            # Already enabled above, this profile just means no USB DMX
            echo "Enabling profile: sacn (network-only)"
            ;;
        *)
            echo "ERROR: Unknown profile: $profile" >&2
            echo "Available: pro, opendmx, artnet, sacn" >&2
            exit 1
            ;;
    esac
done

echo "Restarting olad..."
systemctl restart olad
sleep 1
echo ""
echo "Enabled plugins:"
for id in $(ola_plugin_info --list-plugin-ids 2>/dev/null); do
    info=$(ola_plugin_state -p "$id" 2>/dev/null)
    if echo "$info" | grep -q "Enabled: True"; then
        name=$(echo "$info" | head -1)
        # Add supported hardware models for each plugin
        case "$name" in
            *"USB Serial"*|*"usbserial"*|*"Serial USB"*)
                name="$name  (Enttec DMX USB Pro, DMXking USB DMX512-A/Ultra/Micro)" ;;
            *"FTDI"*|*"ftdidmx"*)
                name="$name  (Enttec Open DMX USB)" ;;
            *"USB DMX"*|*"usbdmx"*)
                name="$name  (Eurolite, Velleman, Nodle, Anyma uDMX)" ;;
            *"ArtNet"*|*"Art-Net"*)
                name="$name  (ArtNet network nodes)" ;;
            *"E1.31"*|*"e131"*|*"sACN"*)
                name="$name  (sACN / E1.31 network nodes)" ;;
        esac
        echo "  $name"
    fi
done
echo ""
echo "Registered devices:"
ola_dev_info 2>/dev/null | grep "^Device" || echo "  (none — olad may still be starting)"
