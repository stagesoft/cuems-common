#!/bin/bash
# SPDX-FileCopyrightText: 2026 Stagelab Coop SCCL
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileContributor: Ion Reguera <ion@stagelab.coop>
#
# cuems-cluster-poweroff — orderly pre-poweroff sequence for a CUEMS controller.
#
# Runs as the ExecStop= of cuems-cluster-poweroff.service, i.e. DURING the
# poweroff transition, and performs, strictly in this order:
#
#     1. projectors / displays OFF   (PJLink)
#     2. cluster node(s) OFF         (SSH, then wait until really down)
#     3. return — systemd then powers this controller off
#
# WHY AN ExecStop= AND NOT AN acpid HANDLER: the /etc/acpi/ chain this package
# used to ship was dead code — acpid is not installed on any CUEMS host, so the
# physical power button is handled by systemd-logind at HandlePowerKey=poweroff.
# Hooking the poweroff *transition* therefore catches the button AND `systemctl
# poweroff` over SSH, with no extra package and no second handler to keep in sync.
#
# WHY NOT THE BRIDGE'S POST /shutdown: that endpoint always arms a Shelly relay
# and fail-safes to HTTP 502 without powering the controller off when no Shelly
# answers — correct for a mains-cut deadline, useless at a venue with no Shelly.
# Here systemd is already powering the box off, so only steps 1-2 are needed.
#
# NO DUPLICATED PROTOCOL LOGIC: every action is performed by the installed
# cuems-power-bridge library (PJLink driver, SSH fan-out, reachability poller)
# against this host's own /etc/cuems/power-bridge.conf, so ssh_user, ssh_key,
# poweroff_cmd, dry_run, projector_power_off_on_shutdown and the projector.N.*
# fleet all keep exactly the meaning the bridge gives them. No secret is ever
# passed on a command line.
#
# Manual use:  cuems-cluster-poweroff --force   (runs the sequence outside a
# poweroff transaction; combine with dry_run=true in power-bridge.conf for a
# zero-risk rehearsal).

set -uo pipefail

CONF=/etc/cuems/cluster-poweroff.conf

# Defaults; /etc/cuems/cluster-poweroff.conf overrides. Shipped disabled so a
# fleet-wide package upgrade changes no site's behaviour until opted in.
enabled=false
node_wait_s=120
projector_timeout_s=25
venv_python=/usr/lib/cuems/bin/python3

# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

# Plain echo, like usr/bin/cuems-journal-vacuum: systemd already captures a
# unit's stdout into the journal. Calling logger() as well put every line in
# twice (once via syslog, once via stdout) AND interleaved the two streams, so
# the log read out of order — e.g. the SSH command appearing before the
# "powering off" line that introduces it.
log() { echo "$*"; }

force=no
[ "${1:-}" = "--force" ] && force=yes

# ---------------------------------------------------------------------------
# Ordering probe — logged on EVERY path, including the skips.
# ---------------------------------------------------------------------------
# The whole design rests on one claim: this unit stops while the network and
# avahi are still up and after the bridge has already stopped. That claim is
# invisible to static inspection, so record the evidence every single time.
# A plain `systemctl reboot` then certifies the ordering for free, forever, on
# a box we may never be able to reach again.
probe() {
    log "ordering probe: power-bridge=$(systemctl is-active cuems-power-bridge 2>/dev/null)" \
        "avahi-daemon=$(systemctl is-active avahi-daemon 2>/dev/null)" \
        "networking=$(systemctl is-active networking 2>/dev/null)" \
        "default-route=$(ip -4 route show default 2>/dev/null | head -1 | tr -s ' ' | cut -d' ' -f1-3 || true)"
}

# ---------------------------------------------------------------------------
# Guard 0 — kill switch.
# ---------------------------------------------------------------------------
case "$enabled" in
    true|yes|1|on) ;;
    *) log "disabled (enabled=$enabled in $CONF) — nothing to do"; exit 0 ;;
esac

# ---------------------------------------------------------------------------
# Guard 1 — act only on a real poweroff/halt.
# ---------------------------------------------------------------------------
# A reboot must NOT power the projectors off: PJLink refuses POWR 1 during lamp
# cooldown (ERR3), so killing the lamps on a reboot returns to a dark room.
# An `isolate rescue.target` / stray `systemctl stop` must be inert too.
# Unknown => skip: powering a venue down unexpectedly is worse than not doing it.
probe
if [ "$force" = yes ]; then
    log "--force given — running the sequence outside a poweroff transaction"
else
    jobs_out="$(timeout 5s systemctl list-jobs --plain --no-legend 2>/dev/null)" || jobs_out=""
    case "$jobs_out" in
        *reboot.target*|*kexec.target*)
            log "reboot in progress — leaving projectors and nodes alone"; exit 0 ;;
    esac
    case "$jobs_out" in
        *poweroff.target*|*halt.target*) log "poweroff transaction detected — running orderly sequence" ;;
        *) log "no poweroff job in the transaction — not a shutdown; nothing to do"; exit 0 ;;
    esac
fi

# Stand the boot-time power-on watchdog down so it cannot POWR 1 behind us.
# In a global poweroff it is already stopped and this is a no-op; it only does
# real work on the --force path. `timeout` because a synchronous systemctl call
# from inside a unit's own script has deadlocked this fleet before (cuems-ap-mode
# vs isc-dhcp-server, cupula1, 2026-08-05) — no cycle exists here, but the
# guard costs nothing.
timeout 10s systemctl stop cuems-displays-on.service 2>/dev/null || true

if [ ! -x "$venv_python" ]; then
    log "ERROR $venv_python missing — cuems-power-bridge not installed? skipping both stages"
    exit 0
fi

# ---------------------------------------------------------------------------
# Stage 1 — displays OFF.
# ---------------------------------------------------------------------------
# Before the venue: the node feeds the projectors, so blanking the node first
# would flash "no signal" on stage before the lamps cut.
log "stage 1/2: displays off"
if timeout "$projector_timeout_s" "$venv_python" -u - <<'PY' 2>&1 | while IFS= read -r l; do log "  $l"; done
import asyncio, logging, sys

logging.basicConfig(level=logging.INFO, format="%(name)s: %(message)s", stream=sys.stdout)
from cuemspowerbridge import config
from cuemspowerbridge.displays.manager import DisplayManager

try:
    cfg = config.load()
except Exception as e:                                     # validate() raises on any bad field
    print(f"ERROR config load/validate failed: {e}", file=sys.stderr)
    sys.exit(3)

if not cfg.projector_power_off_on_shutdown:
    print("projector_power_off_on_shutdown=false — leaving displays alone")
    sys.exit(0)

mgr = DisplayManager.from_config(cfg)
if not mgr.configured:
    print("no displays configured")
    sys.exit(0)


async def main() -> None:
    # Query first, so a redundant pass is cheap and we never fire POWR 0 into a
    # cooldown window (which answers ERR3 and logs an unconfirmed WARNING per
    # device). This is what makes a bridge-driven /shutdown -- whose own step 10
    # runs `sudo /sbin/poweroff`, i.e. a poweroff transaction that re-enters this
    # script -- a fast no-op instead of a full second pass.
    states = await mgr.status_all()
    print("current: " + ", ".join(f"{d['name']}={d['power']}" for d in states))
    if all(d["power"] in ("off", "cooldown") for d in states):
        print("all displays already off/cooling — skipping POWR 0")
        return
    if all(d["power"] == "unknown" for d in states):
        # Not one device answered a status query, so the fleet is unreachable:
        # not cabled, wrong projector.N.host, or network standby disabled. POWR 0
        # would then be 3 attempts plus backoff of near-certain failure —
        # MEASURED at 19s on test2 — added to EVERY poweroff, achieving nothing.
        # Skip, loudly. Deliberately requires ALL devices to be unknown: if even
        # one answered, the fleet is reachable and every device still gets POWR 0,
        # so a single flaky projector is never used as an excuse to skip the rest.
        print("no display answered a status query — fleet unreachable, skipping POWR 0 "
              "(check cabling, projector.N.host, and 'Standby Mode Communications = ON')")
        return
    await mgr.power_off_all()
    print("after:   " + ", ".join(f"{d['name']}={d['power']}" for d in mgr.snapshot()))


asyncio.run(main())
PY
then :; else log "  WARNING stage 1 exited non-zero (see above) — continuing to stage 2"; fi

# ---------------------------------------------------------------------------
# Stage 2 — cluster node(s) OFF.
# ---------------------------------------------------------------------------
log "stage 2/2: cluster nodes off (max wait ${node_wait_s}s)"
if timeout "$((node_wait_s + 30))" "$venv_python" -u - "$node_wait_s" <<'PY' 2>&1 | while IFS= read -r l; do log "  $l"; done
import asyncio, logging, socket, subprocess, sys
import xml.etree.ElementTree as ET

logging.basicConfig(level=logging.INFO, format="%(name)s: %(message)s", stream=sys.stdout)
from cuemspowerbridge import config, network_map, reachability
from cuemspowerbridge.node_executor import SshTarget, poweroff_all

node_wait_s = int(sys.argv[1])

try:
    cfg = config.load()
except Exception as e:
    print(f"ERROR config load/validate failed: {e}", file=sys.stderr)
    sys.exit(3)


def local_addresses() -> set[str]:
    """Every address on this host, both families, as exact strings."""
    addrs: set[str] = set()
    try:
        out = subprocess.run(["ip", "-o", "addr", "show"],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception as e:
        print(f"WARNING could not enumerate local addresses ({e})")
        return addrs
    for line in out.splitlines():
        fields = line.split()
        for i, tok in enumerate(fields):
            if tok in ("inet", "inet6") and i + 1 < len(fields):
                addrs.add(fields[i + 1].split("/")[0])
    return addrs


def own_uuid() -> str | None:
    """This host's own node uuid from settings.xml (matches the network_map
    NodeType.master entry). The one identifier that is stable by contract."""
    try:
        for el in ET.parse(cfg.settings_xml_path).getroot().iter():
            if el.tag.split("}", 1)[-1] == "uuid" and el.text and el.text.strip():
                return el.text.strip()
    except Exception:
        pass
    return None


def resolve(name: str) -> set[str]:
    """Resolve through NSS (so nss-mdns/avahi answers .local), both families."""
    try:
        return {ai[4][0] for ai in socket.getaddrinfo(name, None)}
    except OSError:
        return set()


# --- self-exclusion --------------------------------------------------------
# A standalone controller is its own node, and its network_map may carry a
# self-entry. SSHing `sudo /sbin/poweroff` to yourself mid-transition is bad;
# worse, a host can never observe ITSELF unreachable, so a missed self-entry
# burns the whole node_wait_s on every single poweroff.
#
# Hostname matching alone is NOT enough here: cuems-nodeconf never ran on these
# boxes, so it never called `hostnamectl set-hostname <role_id>` — the OS
# hostname is e.g. "cupula1" while the avahi name is "node01.local". Hence uuid
# first, then EXACT address-set membership (never a substring test: 10.16.10.1
# is a substring of 10.16.10.10).
mine = local_addresses()
my_uuid = own_uuid()
my_names = {socket.gethostname().lower(), socket.getfqdn().lower()}

targets: list[str] = []
for n in network_map.parse(cfg.network_map_path):
    if n.node_type != "NodeType.slave":
        continue
    if not n.avahi:
        print(f"ERROR slave uuid={n.uuid} has no role_id/alias/hostname — skipped "
              "(it will not power off cleanly)")
        continue

    reason = None
    if my_uuid and n.uuid == my_uuid:
        reason = f"uuid {n.uuid} is this host"
    else:
        ips = resolve(n.avahi)
        if not ips:
            print(f"ERROR {n.avahi} does not resolve — skipped")
            continue
        shared = ips & mine
        if shared:
            reason = f"resolves to a local address ({', '.join(sorted(shared))})"
        elif all(ip.startswith("127.") or ip == "::1" for ip in ips):
            reason = "resolves to loopback"
        elif n.avahi.split(".")[0].lower() in my_names or (n.role_id or "").lower() in my_names:
            reason = "name is this host"
    if reason:
        print(f"SELF-EXCLUDED {n.avahi}: {reason}")
        continue
    targets.append(n.avahi)


async def main() -> None:
    if not targets:
        print("no node targets — standalone controller, or all entries self-excluded")
        return

    # One liveness pass. confirm_failures=1 is load-bearing: at the default 3 a
    # single pass leaves EVERY host unconfirmed and this would return them all.
    #
    # Silence the poller's own logger for this call only: a deliberate
    # max_wait_s=0 probe makes it emit "timeout after 0.0s; stuck hosts: ..." at
    # WARNING, which in a shutdown log reads like a fault when it is in fact the
    # expected answer ("these hosts are alive"). The real wait below keeps its
    # logging, where "confirmed down" is exactly what we want to see.
    reach_log = logging.getLogger("cuemspowerbridge.reachability")
    prev_level = reach_log.level
    reach_log.setLevel(logging.ERROR)
    try:
        snap = await reachability.wait_until_all_down(
            targets, interval_s=0.1, max_wait_s=0, confirm_failures=1)
    finally:
        reach_log.setLevel(prev_level)
    alive = list(snap.stuck_hosts)
    already = [h for h in targets if h not in alive]
    if already:
        print("already down: " + ", ".join(already))
    if not alive:
        print("all node(s) already down — skipping SSH fan-out")
        return

    print("powering off: " + ", ".join(alive))
    await poweroff_all(
        [SshTarget(host=h, user=cfg.ssh_user, key_path=cfg.ssh_key,
                   poweroff_cmd=cfg.poweroff_cmd) for h in alive],
        dry_run=cfg.dry_run,
    )
    if cfg.dry_run:
        print("[dry_run] not waiting for nodes to go down")
        return

    # ssh returns 255 as a node drops — expected. The poll is the ack.
    res = await reachability.wait_until_all_down(
        alive, interval_s=2.0, max_wait_s=node_wait_s)
    if res.timed_out:
        print(f"WARNING timeout after {res.elapsed_s:.1f}s; still up: "
              + ", ".join(res.stuck_hosts) + " — powering off anyway")
    else:
        print(f"all node(s) confirmed down in {res.elapsed_s:.1f}s")


asyncio.run(main())
PY
then :; else log "  WARNING stage 2 exited non-zero (see above)"; fi

log "orderly sequence complete — handing back to systemd"
exit 0
