[Unit]
Description=cuems-wifi
# When systemd stops or restarts the app.service, the action is propagated to this unit
PartOf=cuems-controller.target
# Stopping the group through cuems-wifi.target must take the AP data path down
# with it, otherwise 192.168.6.1 stays on a wifi0 that is no longer an AP.
PartOf=cuems-wifi.target
# Start this unit after the app.service start
After=network.target cuems-controller.target
Requires=isc-dhcp-server.service
Before=hostapd.service

[Service]
Type=oneshot
# Gate 1 (see check-ip.sh): a controller, armed, with a wifi0, and either
# NET_MODE=ap or NET_MODE=auto on the fallback address with no cable.
ExecCondition=/usr/lib/cuems/bin/check-ip.sh
RemainAfterExit=yes
# ExecStart= stays /bin/true and all behaviour lives in ExecCondition=,
# ExecStartPost= and ExecStop=: those three are exactly what the venue drop-ins
# (Medina, formitgo) clear, so a site that manages its own AP inherits nothing
# new from here.
ExecStart=/bin/true
# Moves the gateway address from bond0 to wifi0 BEFORE dhcpd and hostapd start
# (address first, then dhcpd, then hostapd). Replaces the `ip link set
# ethernet0 down` takeover used until 1.3.0-22: the AP no longer takes the
# cable down nor stops dhclient, so plugging a cable in later still gets a lease.
ExecStartPost=/usr/lib/cuems/bin/cuems-ap-path up
# ExecStop fires only when the unit transitioned through active. If
# ExecCondition (check-ip.sh) returned 1, the unit never entered active
# and this never runs. systemd.service(5) semantics.
ExecStop=/usr/lib/cuems/bin/cuems-ap-path down

[Install]
WantedBy=cuems-wifi.target multi-user.target
