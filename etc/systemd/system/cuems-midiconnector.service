[Unit]
Description=cuems-midiconnector
# Bind to cuems-node.target so the daemon runs on every CUEMS host.
# cuems-controller.target Requires=cuems-node.target, so controllers
# also pull it in transitively — no per-role drop-in needed.
PartOf=cuems-node.target
# rtpmidid must be up before we scan ALSA seq: the daemon's startup
# wiring pass would otherwise miss the rtpmidid client and rely on a
# follow-up CLIENT_START event.
Requires=rtpmidid.service
After=rtpmidid.service avahi-daemon.service
StartLimitBurst=5
StartLimitIntervalSec=33

[Service]
User=cuems
Group=cuems
SupplementaryGroups=audio
# Type=notify so systemd treats the unit as active only once the ALSA
# port is created and the event loop is running. The daemon calls
# sd_notify("READY=1") via cuemsutils.tools.SignalEngine.notify_systemd().
Type=notify
NotifyAccess=main
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
TimeoutStartSec=60
ExecStart=/usr/lib/cuems/bin/cuems-midiconnector
# PrivateTmp=no: CUEMS services share /tmp for NNG IPC sockets
PrivateTmp=no
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cuems_library /tmp

[Install]
WantedBy=cuems-node.target
