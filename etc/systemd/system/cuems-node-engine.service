[Unit]
Description=cuems-node-engine
#PartOf=cuems-node.service
Requires=avahi-daemon.service
After=network-online.target avahi-daemon.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=33


[Service]
#Environment="PYTHONPATH=/usr/lib/cuems/site-packages"
Type=simple
#NotifyAccess=main
#Restart=on-failure
RestartSec=10
ExecStart=/usr/lib/cuems/bin/node-engine --daemon
TimeoutSec=900

[Install]
WantedBy=default.target
