[Unit]
Description=cuems-node-engine
PartOf=cuems-node.target
Requires=avahi-daemon.service jackd-cuems.service jack-alsa-bridges.service
# After cuems-videocomposer.service so /run/cuems/display.conf (written by
# its ExecStartPre cuems-generate-display-conf) is present when the engine
# reads it in NodeEngine.set_video_outputs.
After=network-online.target avahi-daemon.service jackd-cuems.service jack-alsa-bridges.service cuems-videocomposer.service
Wants=cuems-videocomposer.service
StartLimitBurst=5
StartLimitIntervalSec=33

[Service]
User=cuems
Group=cuems
Type=simple
Environment="LD_LIBRARY_PATH=/usr/lib/cuems/lib/python3.11/site-packages/rtmidi"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
TimeoutStartSec=60
ExecStartPre=-/bin/sh -c '/usr/bin/pkill -u cuems -f "xjadeo.*--osc|cuems-audioplayer|cuems-dmxplayer|jack-volume" || true'
ExecStartPre=-/bin/sleep 1
ExecStart=/usr/lib/cuems/bin/node-engine
ExecStopPost=-/bin/sh -c '/usr/bin/pkill -u cuems -f "xjadeo.*--osc|cuems-audioplayer|cuems-dmxplayer|jack-volume" || true'
# PrivateTmp=no: CUEMS services share /tmp for NNG IPC sockets
PrivateTmp=no
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cuems_library /tmp

[Install]
WantedBy=cuems-node.target
