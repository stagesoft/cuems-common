[Unit]
Description=CUEMS Video Composer (multi-layer video compositor)
Documentation=https://github.com/cuems/cuems-videocomposer
PartOf=cuems-node.target
# Start after display and GPU/DRI are available
After=graphical.target
Wants=graphical.target
# Optional: wait for DRI device if udev tags it (dev-dri-card0.device)
# After=dev-dri-card0.device

[Service]
Type=simple
User=cuems
Group=cuems
# DRI/GPU access: video and render groups; audio for ALSA MIDI (/dev/snd/seq)
SupplementaryGroups=video render audio
# Environment for GPU/display (adjust for your setup)
Environment=HOME=/var/lib/cuems
# Generate display config from default_mappings.xml before starting
ExecStartPre=/usr/lib/cuems/bin/cuems-generate-display-conf
ExecStart=/usr/bin/cuems-videocomposer
# --- Tuning display-pipeline latency compensation ---
# cuems-videocomposer accepts --output-latency-ms <int> to set the
# display-pipeline latency compensation (default 33 ms, range 0-500).
# This cannot be read from settings.xml because videocomposer is a
# systemd service, not a subprocess of the engine. To tune per node
# without editing this unit file, create a drop-in override:
#
#   sudo systemctl edit cuems-videocomposer
#
# and add:
#
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/cuems-videocomposer --output-latency-ms 33
#
# Typical starting points: 16-33 ms for direct-scanout (DRM/KMS),
# 40-66 ms for compositor-mediated (Wayland/X11). Measure with a
# phone camera at 120 fps pointed at a frame-counter overlay.
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cuems-videocomposer

# DRI/ALSA: need access to device nodes (run with User=, SupplementaryGroups=video render audio)
# PrivateTmp=no: CUEMS services share /tmp for NNG IPC sockets
PrivateTmp=no
NoNewPrivileges=yes
# Do not use PrivateDevices so /dev/dri and /dev/snd are visible
PrivateDevices=no
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/cuems
RuntimeDirectory=cuems

[Install]
WantedBy=cuems-node.target
