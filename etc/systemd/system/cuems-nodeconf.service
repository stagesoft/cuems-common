[Unit]
Description=cuems-nodeconf
PartOf=cuems-node.service
Requires=avahi-daemon.service
After=network-online.target avahi-daemon.service
Wants=network-online.target


[Service]
Type=notify
NotifyAccess=main
Restart=no
ExecStart=/home/stagelab/.pyenv/versions/cuems/bin/python3 /home/stagelab/src/cuems/cuems-engine/src/nodeconf.py
SuccessExitStatus=100 101
TimeoutSec=900

[Install]
WantedBy=default.target