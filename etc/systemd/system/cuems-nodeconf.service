[Unit]
Description=cuems-nodeconf
PartOf=cuems-node.service
Requires=avahi-daemon.service
After=network-online.target avahi-daemon.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=33


[Service]
#Environment="PYTHONPATH=/usr/lib/cuems/site-packages"
Type=notify
RemainAfterExit=yes
NotifyAccess=main
Restart=on-failure
RestartSec=10
ExecStart=/usr/lib/cuems/bin/cuems-nodeconf
TimeoutSec=900

[Install]
WantedBy=default.target
