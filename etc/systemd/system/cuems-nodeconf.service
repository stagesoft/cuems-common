[Unit]
Description=cuems-nodeconf
PartOf=cuems-node.target
Requires=avahi-daemon.service
After=network-online.target avahi-daemon.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=33

[Service]
# Runs as root: writes to /etc/network/interfaces, /etc/avahi/services/,
# controls systemd services via DBus. Cannot be demoted to unprivileged user.
Type=notify
# NB: no RemainAfterExit. nodeconf is now a long-running daemon (resident avahi
# discovery loop + alias supervision). RemainAfterExit=yes would leave the unit
# showing "active (exited)" if the process died, masking the failure from
# dependents and from Restart= monitoring.
NotifyAccess=main
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
TimeoutStartSec=60
ExecStart=/usr/lib/cuems/bin/cuems-nodeconf

[Install]
WantedBy=cuems-node.target
