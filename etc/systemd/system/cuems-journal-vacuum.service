[Unit]
Description=Prune collected and orphaned journals on a CUEMS host
Documentation=man:systemd-journal-remote(8) man:journalctl(1)
After=systemd-journal-remote.service

# No [Install] section on purpose: the schedule belongs to
# cuems-journal-vacuum.timer, which is what gets enabled. Run a prune by
# hand with `systemctl start cuems-journal-vacuum.service`.

[Service]
Type=oneshot
ExecStart=/usr/bin/cuems-journal-vacuum
StandardOutput=journal
StandardError=journal

# Retention for /var/log/journal/remote/. systemd-journal-remote has no
# equivalent of journald's SystemMaxUse=, so this is the only bound on the
# journals uploaded by the nodes. Override per site with
# `systemctl edit cuems-journal-vacuum.service`.
Environment=CUEMS_JOURNAL_REMOTE_MAX_SIZE=8G
Environment=CUEMS_JOURNAL_REMOTE_MAX_AGE=30d

# Also delete journal directories belonging to OTHER machines, inherited by
# cloning a master image. Nothing else bounds them: journald's SystemMaxUse=
# applies only to its own machine-id directory. Set to 0 to disable.
Environment=CUEMS_JOURNAL_PRUNE_FOREIGN=1

# Vacuuming only reads and unlinks journal files. The write scope is the whole
# journal tree — not just remote/ — because foreign machine-id directories are
# removed at that level. The script refuses to touch this host's own directory.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/journal
PrivateDevices=yes
NoNewPrivileges=yes
RestrictRealtime=yes
