[Unit]
Description=Daily journal maintenance for CUEMS hosts
Documentation=man:systemd-journal-remote(8)
# Deliberately NOT PartOf=cuems-controller.target: log maintenance must not be
# stopped or restarted along with the show stack. A controller-target bounce
# used to cancel the timer.

[Timer]
# Daily, well away from show hours, with jitter so a rack of controllers
# does not all churn /var at the same instant.
OnCalendar=*-*-* 05:30:00
RandomizedDelaySec=30m
# A host powered off overnight still gets pruned on next boot.
Persistent=true

[Install]
# EVERY host, not just controllers (was WantedBy=cuems-controller.target).
# Nodes need this too: they carry the same foreign machine-id journal
# directories inherited from the master image, and a node that was ever a
# controller — or was cloned from one — keeps a /var/log/journal/remote that
# nothing else would ever prune. Observed on isil node01: 17G of /var/log, of
# which 11G orphans and 3.7G stale remote/, on a host where this timer could
# never fire. cuems-journal-vacuum is a no-op on anything it finds clean.
WantedBy=timers.target
