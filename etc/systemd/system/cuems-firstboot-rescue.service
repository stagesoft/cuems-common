# Started only when the first boot fails.

[Unit]
Description=Make a box whose first boot failed reachable
Documentation=file:/usr/share/doc/cuems-common/first-boot.md
# It puts DHCP clients on the raw ports: never on a box in service.
ConditionPathExists=/var/lib/cuems/firstboot.armed

[Service]
Type=oneshot
RemainAfterExit=yes
# The DHCP clients it starts stay running.
ExecStart=/usr/lib/cuems/bin/cuems-firstboot-rescue
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=cuems-firstboot-rescue
