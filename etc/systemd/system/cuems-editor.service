[Unit]
Description=cuems-editor
PartOf=cuems-controller.target
After=cuems-controller-engine.service apache2.service
Requires=cuems-controller-engine.service apache2.service

[Service]
User=stagelab
Group=stagelab
Type=simple
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
TimeoutStartSec=30
RuntimeDirectory=cuems-editor
PIDFile=/run/cuems-editor/service.pid
ExecStart=/usr/lib/cuems/bin/cuems-editor
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cuems /tmp

[Install]
WantedBy=cuems-controller.target
