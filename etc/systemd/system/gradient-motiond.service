[Unit]
Description=CUEMS Gradient Motion Engine (fade-engine)
Documentation=https://github.com/stagesoft/gradient-motion-engine
PartOf=cuems-node.target
After=network.target avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=simple
User=cuems
Group=cuems
# ALSA MIDI for MTC reception (/dev/snd/seq)
SupplementaryGroups=audio
Environment=HOME=/var/lib/cuems
# Use the controller.local avahi alias — always resolves to the current
# controller IP regardless of node topology changes. The nng_hub_port
# (9093) is a CUEMS-wide constant; override by editing the unit or
# creating /etc/systemd/system/gradient-motiond.service.d/ drop-in.
ExecStart=/usr/bin/gradient-motiond --nng-url tcp://controller.local:9093
Restart=on-failure
RestartSec=5

[Install]
WantedBy=cuems-node.target
