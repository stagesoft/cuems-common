[Unit]
Description=cuems-xorg
PartOf=cuems-node.service
After=systemd-user-sessions.service

[Service]
Environment="DISPLAY=:0.0"
Type=exec
Restart=always
ExecStartPre=/bin/mkdir -p /run/cuems-xorg
PIDFile=/run/cuems-xorg/service.pid
ExecStart=/usr/bin/xinit /etc/X11/xinit/xinitrc.cuems -- /usr/bin/X -br -nocursor

[Install]
WantedBy=cuems-engine.service