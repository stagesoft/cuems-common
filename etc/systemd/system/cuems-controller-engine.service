[Unit]
Description=cuems-controller-engine
PartOf=cuems-controller.target
Requires=avahi-daemon.service
After=network-online.target avahi-daemon.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=33

[Service]
User=stagelab
Group=stagelab
Type=simple
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
TimeoutStartSec=60
ExecStart=/usr/lib/cuems/bin/controller-engine
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cuems /tmp

[Install]
WantedBy=cuems-controller.target
