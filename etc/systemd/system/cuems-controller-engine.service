[Unit]
Description=cuems-controller-engine
PartOf=cuems-controller.target
Requires=avahi-daemon.service
# After cuems-videocomposer.service so /run/cuems/display.conf (written by
# its ExecStartPre cuems-generate-display-conf) is present when the engine
# reads it. Wants (not Requires) so the controller can start even on hosts
# without a videocomposer install — the engine raises with a clear error in
# that case instead of crash-looping silently.
After=network-online.target avahi-daemon.service cuems-videocomposer.service
Wants=network-online.target cuems-videocomposer.service
StartLimitBurst=5
StartLimitIntervalSec=33

[Service]
User=cuems
Group=cuems
Type=simple
Environment="LD_LIBRARY_PATH=/usr/lib/cuems/lib/python3.11/site-packages/rtmidi"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
TimeoutStartSec=60
ExecStart=/usr/lib/cuems/bin/controller-engine
# PrivateTmp=no: CUEMS services share /tmp for NNG IPC sockets
PrivateTmp=no
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/cuems_library /tmp

[Install]
WantedBy=cuems-controller.target
