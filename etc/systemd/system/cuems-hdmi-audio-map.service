[Unit]
Description=Detect HDMI/DP audio mapping and generate asound.conf
Documentation=man:aplay(1)
After=sound.target
Before=jackd-cuems.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cuems-hdmi-audio-map
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
