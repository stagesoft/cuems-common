[Unit]
Description=CUEMS Gradient Motion Engine daemon
Documentation=https://github.com/stagesoft/gradient-motion-engine
PartOf=cuems-node.target
After=network.target

[Service]
Type=simple
User=cuems
Group=cuems
# ALSA MIDI for MTC reception (/dev/snd/seq)
SupplementaryGroups=audio
Environment=HOME=/var/lib/cuems
# UDP OSC command port (v0.3.0+). Default 7100; per-node overrides in
# /etc/cuems/gradient-motiond.env (optional — see gradient-motiond.env.example).
EnvironmentFile=-/etc/cuems/gradient-motiond.env
ExecStart=/usr/bin/gradient-motiond \
    --midi-port "Midi Through Port-0" \
    --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=Cuems:GradientEngine

[Install]
WantedBy=cuems-node.target
