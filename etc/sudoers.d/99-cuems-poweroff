#
# Allow the cuems service user to power off the local host without a
# password prompt. Used by:
#   - cuems-power-bridge (controller): local poweroff after arming Shelly
#     hardware safety timer.
#   - NOT the node side: the controller SSHes into nodes as cuems-admin
#     (see 99-cuems-admin-poweroff), not as cuems, which is /usr/sbin/nologin.
#     This rule is shipped on every host by policy and is simply unused on a
#     node today. It becomes the node-side rule again when node power-off moves
#     to the engine over NNG.
#
# Shipped on EVERY CUEMS host (controllers + nodes) by policy; harmless
# on a host whose role doesn't actually invoke it.
cuems ALL=(root) NOPASSWD: /sbin/poweroff
# systemctl path is /usr/bin/systemctl on bookworm (usr-merge); /sbin/systemctl
# does NOT exist. Used only if controller_poweroff_cmd is set to a systemctl
# invocation (systemctl accepts --no-block, which the /sbin/poweroff applet rejects).
cuems ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff
cuems ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff --no-block
