# CUEMS videocomposer — operator-tunable CLI flags.
#
# Shell-style KEY=VALUE pairs, read by cuems-videocomposer.service via
# EnvironmentFile=-/etc/cuems/videocomposer-flags.env. The systemd unit
# substitutes $OPERATOR_FLAGS into the ExecStart line so you can add
# whatever cuems-videocomposer CLI flags you need without writing a
# systemd drop-in.
#
# How to use:
#   1. Copy this file to /etc/cuems/videocomposer-flags.env
#   2. Edit OPERATOR_FLAGS to the flags you want active on this node
#   3. sudo systemctl restart cuems-videocomposer
#
# To disable a flag: comment out or empty the value.
# To disable all: delete /etc/cuems/videocomposer-flags.env (the
# leading `-` on the service's EnvironmentFile makes missing OK).
#
# Do NOT set --output-latency-ms here — that value is driven by
# /etc/cuems/settings.xml videoplayer/output_latency_ms and flows
# through a separate env file (/run/cuems/videocomposer.env). Setting
# it here would be ignored on the engine side and cause duplicate flags.

# Enable verbose logging (videocomposer stderr → journal)
#OPERATOR_FLAGS=--verbose

# Leave commented / empty for default (no extra flags)
OPERATOR_FLAGS=
