#!/usr/lib/cuems/bin/python3
"""Resolve the CUEMS log collector URL for systemd-journal-upload.

Takes the controller's address by the shared rule (cuems_controller_address:
controller.local unless it gives a loopback address, else the controller's <ip> in
/etc/cuems/network_map.xml) and writes URL=http://<ip>:19532 to
/run/cuems-journal-upload/url.env so the upload service can pick it up via
EnvironmentFile=.

Designed to run as ExecStartPre for systemd-journal-upload.service.
Fails LOUDLY (non-zero exit + stderr) so systemctl status surfaces
the root cause when something's off - never silently produces an
empty/stale env file.
"""

import socket
import sys
from pathlib import Path

# The rule for the controller's address is shared with the other helpers. It sits
# beside bin/ once installed, and under usr/lib/cuems/ in the source tree.
sys.dont_write_bytecode = True
# Appended, never prepended: /usr/lib/cuems is also the shared venv's directory.
sys.path += [str(Path(__file__).resolve().parents[1]),
             str(Path(__file__).resolve().parents[1] / "usr/lib/cuems")]
from cuems_controller_address import controller_address  # noqa: E402

NETWORK_MAP = Path("/etc/cuems/network_map.xml")
ENV_FILE = Path("/run/cuems-journal-upload/url.env")
COLLECTOR_PORT = 19532


def die(msg: str, *, code: int = 1) -> None:
    print(f"cuems-log-collector-url: ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def main() -> None:
    try:
        master_ip = controller_address(NETWORK_MAP, socket.gethostbyname)
    except LookupError as e:
        die(str(e))

    url = f"http://{master_ip}:{COLLECTOR_PORT}"

    ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
    ENV_FILE.write_text(f"URL={url}\n")
    print(f"cuems-log-collector-url: URL={url}", file=sys.stderr)


if __name__ == "__main__":
    main()
