#!/usr/lib/cuems/bin/python3
"""Apply role-aware chrony configuration for the CUEMS cluster.

Runs as ExecStartPre on chrony.service (with `+` prefix so it runs as
root, bypassing chrony's ProtectSystem=strict). Idempotent and
role-flip-aware: detects role on every chrony start from /etc/cuems/
master.ip and writes the correct config + cleans up stale files from
the other role. This means promotion (slave -> master) and demotion
(master -> slave) just need:

    touch /etc/cuems/master.ip    # or `rm` to demote
    systemctl restart chrony

On master:
  - Copies /usr/share/cuems/chrony-server.conf.template to
    /etc/chrony/conf.d/cuems.conf (allow link-local + local stratum 8).
  - Deletes /etc/chrony/sources.d/cuems-master.sources (left over from
    a previous slave role, would point at a non-existent peer).

On slave:
  - Copies /usr/share/cuems/chrony-client.conf.template to
    /etc/chrony/conf.d/cuems.conf (maxdistance 16 + makestep 1 -1
    to absorb large initial offsets from freshly-cloned hardware).
  - Reads /etc/cuems/network_map.xml, finds the node with
    node_role='controller' and its <ip>, writes
    /etc/chrony/sources.d/cuems-master.sources with one line:
        server <master-ip> iburst minpoll 4 maxpoll 6

On a node whose map names NO controller (a fresh install before the map is
provisioned — the package ships network_map.xml with an empty node list — or a
host that took the maintainer's version of that conffile): installs the client
config, removes its own cuems-master.sources if present, logs a WARNING naming
the map, and exits 0. chrony then runs with no cluster time source instead of
failing to start; provisioning the map ends the warning.

Fails LOUDLY (stderr + non-zero exit) on everything else that is wrong — a
missing or unparseable map, a controller entry with an empty <ip>, or a map that
names a controller the search expression cannot reach — so `systemctl status
chrony` surfaces the root cause. The script name is historical — it now does
more than just sources.d.
"""

import shutil
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

MASTER_MARKER = Path("/etc/cuems/master.ip")
NETWORK_MAP = Path("/etc/cuems/network_map.xml")

CUEMS_CONF = Path("/etc/chrony/conf.d/cuems.conf")
SOURCES_FILE = Path("/etc/chrony/sources.d/cuems-master.sources")

SERVER_TEMPLATE = Path("/usr/share/cuems/chrony-server.conf.template")
CLIENT_TEMPLATE = Path("/usr/share/cuems/chrony-client.conf.template")


def die(msg: str, *, code: int = 1) -> None:
    print(f"cuems-write-chrony-source: ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def log(msg: str) -> None:
    print(f"cuems-write-chrony-source: {msg}", file=sys.stderr)


def warn(msg: str) -> None:
    print(f"cuems-write-chrony-source: WARNING: {msg}", file=sys.stderr)


def install_template(src: Path, dst: Path) -> None:
    try:
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(src, dst)
    except OSError as e:
        die(f"failed to install {src} -> {dst}: {e}")


def apply_master() -> None:
    if not SERVER_TEMPLATE.exists():
        die(f"{SERVER_TEMPLATE} missing — is cuems-common installed correctly?")
    install_template(SERVER_TEMPLATE, CUEMS_CONF)
    log(f"installed {SERVER_TEMPLATE.name} -> {CUEMS_CONF}")
    # Clean up sources.d entry left over from a previous slave role —
    # would otherwise have master try to NTP-sync to itself.
    if SOURCES_FILE.exists():
        try:
            SOURCES_FILE.unlink()
            log(f"removed stale {SOURCES_FILE} (role flipped to master)")
        except OSError as e:
            die(f"failed to remove {SOURCES_FILE}: {e}")


def _names_a_controller(root: ET.Element) -> bool:
    """True if any element named node_role (in any namespace) says controller."""
    return any(
        el.tag.rsplit("}", 1)[-1] == "node_role" and (el.text or "").strip() == "controller"
        for el in root.iter()
    )


def read_master_ip() -> str | None:
    """The controller's IP, or None when the map names no controller at all."""
    if not NETWORK_MAP.exists():
        die(f"{NETWORK_MAP} not found — is /etc/cuems populated for this role?")
    try:
        tree = ET.parse(NETWORK_MAP)
    except ET.ParseError as e:
        die(f"failed to parse {NETWORK_MAP}: {e}")
    root = tree.getroot()
    elem = root.find("./node_list/node[node_role='controller']/ip")
    if elem is None and not _names_a_controller(root):
        return None
    if elem is None:
        first_child = list(root)[0].tag if list(root) else "<none>"
        die(
            "could not find a node with node_role='controller' in "
            f"network_map.xml — root tag was {root.tag!r}, first child was "
            f"{first_child!r}. Search expression: "
            "./node_list/node[node_role='controller']/ip. "
            "If element names are now namespaced (e.g. {http://...}node), "
            "the helper must be updated."
        )
    ip = (elem.text or "").strip()
    if not ip:
        die("controller node found but its <ip> tag is empty")
    return ip


def apply_slave() -> None:
    if not CLIENT_TEMPLATE.exists():
        die(f"{CLIENT_TEMPLATE} missing — is cuems-common installed correctly?")
    install_template(CLIENT_TEMPLATE, CUEMS_CONF)
    log(f"installed {CLIENT_TEMPLATE.name} -> {CUEMS_CONF}")

    master_ip = read_master_ip()
    if master_ip is None:
        if SOURCES_FILE.exists():
            try:
                SOURCES_FILE.unlink()
                log(f"removed {SOURCES_FILE} (the map names no controller)")
            except OSError as e:
                die(f"failed to remove {SOURCES_FILE}: {e}")
        warn(
            f"{NETWORK_MAP} names no controller — chrony runs with no cluster time "
            "source until the map is provisioned (see /usr/share/doc/cuems-common/"
            "network_map.xml.example)"
        )
        return
    line = f"server {master_ip} iburst minpoll 4 maxpoll 6\n"
    try:
        SOURCES_FILE.parent.mkdir(parents=True, exist_ok=True)
        SOURCES_FILE.write_text(line)
    except OSError as e:
        die(f"failed to write {SOURCES_FILE}: {e}")
    log(line.rstrip())


def main() -> None:
    if MASTER_MARKER.exists():
        apply_master()
    else:
        apply_slave()


if __name__ == "__main__":
    main()
